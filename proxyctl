def build_parser():
    p = argparse.ArgumentParser(
        prog="proxyctl",
        description="基于 dae 的按应用代理管理工具（Proxifier 式）。dae 负责分流，proxyctl 只管理规则。")
    p.add_argument("--version", action="version", version="proxyctl " + VERSION)
    sub = p.add_subparsers(dest="cmd", metavar="<命令>")
    sub.required = True

    sub.add_parser("init", help="初始化管理区块并迁移已有规则（幂等，需要 root）")
    for name, h in (("add", "加入代理名单"), ("remove", "从代理名单移除"),
                    ("protect", "加入直连保护（must_direct）"), ("unprotect", "从直连保护移除")):
        sp = sub.add_parser(name, help=h + "（需要 root）")
        sp.add_argument("name", help="进程名（以 dae 日志中的 pname 为准）")
    sub.add_parser("rules", help="显示规则")
    sub.add_parser("list", help="列出当前正在联网的进程")
    sub.add_parser("pick", help="交互式选择联网进程并加入代理名单")
    sp = sub.add_parser("check", help="只读健康检查")
    sp.add_argument("--quiet", action="store_true", help="只输出 WARN / FAIL")
    sp.add_argument("--notify", action="store_true", help="有 FAIL 时弹出桌面通知")
    sp.add_argument("--basic", action="store_true",
                    help="只检查 dae 状态、SOCKS 端口、代理核心和代理链路（定时器使用；链路正常时每 2 分钟探测一次）")
    sub.add_parser("test", help="端到端自检")
    sp = sub.add_parser("run", help="确认代理可用后再启动程序")
    sp.add_argument("--wait", type=int, default=0, metavar="N", help="最多等待 N 秒")
    sp.add_argument("command", nargs=argparse.REMAINDER, help="-- 之后的命令")
    sp = sub.add_parser("guard-desktop", help="为 .desktop 启动器生成带启动守卫的覆盖副本")
    sp.add_argument("desktop", help="desktop 文件名，例如 signal-desktop.desktop")
    sp.add_argument("--undo", action="store_true", help="撤销")
    sp = sub.add_parser("dns", help="显示代理名单中程序的 DNS 走向；--protect 开关 DNS 防泄漏")
    sp.add_argument("name", nargs="?", help="只看这个进程名（可以不在代理名单中）")
    sp.add_argument("--protect", choices=("on", "off"),
                    help="DNS 防泄漏：on = 国外域名经代理查询，运营商看不到；off = 恢复原来的走法（需要 root）")
    sp = sub.add_parser("export", help="导出规则：代理名单和直连保护（JSON，只含进程名）")
    sp.add_argument("file", nargs="?", help="输出文件；省略或为 - 时输出到终端")
    sp = sub.add_parser("import", help="从导出文件导入规则（需要 root）")
    sp.add_argument("file", help="proxyctl export 生成的 JSON 文件")
    sp.add_argument("--replace", action="store_true",
                    help="用文件内容替换现有规则（默认是合并：只新增，不删除）")
    sp = sub.add_parser("history", help="代理链路延迟记录：每小时的中位 / 最慢耗时、失败、异常时段和内核切换")
    sp.add_argument("--hours", type=int, default=24, metavar="N", help="查看最近 N 小时（默认 24，最多 168）")
    sub.add_parser("backups", help="列出配置备份")
    sp = sub.add_parser("restore", help="恢复备份（需要 root）")
    sp.add_argument("backup", help="备份名")
    sub.add_parser("gui", help="启动图形界面")
    return p


HANDLERS = {
    "init": cmd_init, "add": cmd_add, "remove": cmd_remove, "protect": cmd_protect,
    "unprotect": cmd_unprotect, "rules": cmd_rules, "list": cmd_list, "pick": cmd_pick,
    "check": cmd_check, "test": cmd_test, "run": cmd_run, "guard-desktop": cmd_guard_desktop,
    "backups": cmd_backups, "restore": cmd_restore, "gui": cmd_gui,
    "export": cmd_export, "import": cmd_import, "dns": cmd_dns, "history": cmd_history,
}
WRITE_CMDS = {"init", "add", "remove", "protect", "unprotect", "restore", "import"}


def _backups_need_root():
    d = backup_dir()
    return os.path.exists(d) and not os.access(d, os.R_OK | os.X_OK)


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    args = build_parser().parse_args(argv)
    try:
        if args.cmd in WRITE_CMDS:
            if args.cmd in ("add", "protect", "remove", "unprotect"):
                validate_name(args.name)  # 提权前先拒绝明显非法的输入
            if args.cmd == "add" and is_blacklisted(args.name):
                raise ProxyctlError("拒绝加入代理名单。" + blacklist_reason(args.name))
            if args.cmd == "import":
                args.file = os.path.abspath(args.file)
                argv = ["import", args.file] + (["--replace"] if args.replace else [])
                if os.access(args.file, os.R_OK):
                    read_import_file(args.file)  # 提权前先检查文件，坏文件不触发 sudo 密码提示
            ensure_root(argv, lambda: not can_write_config())
        elif args.cmd == "dns" and args.protect:
            ensure_root(argv, lambda: not can_write_config())
        elif args.cmd == "backups":
            ensure_root(argv, _backups_need_root)
        return HANDLERS[args.cmd](args) or 0
    except ProxyctlError as e:
        print("错误：%s" % e, file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        print("\n已中断。", file=sys.stderr)
        return 130


if __name__ == "__main__":
    sys.exit(main())
