def gui_row_actions(name, status, view):
    """GUI 联网进程表中每一行可用的操作，返回 [(按钮文字, 子命令参数, 是否可点, 提示), ...]。

    只给出真正可以执行的操作：已代理的只能“移除代理”，直连保护的只能“取消保护”，
    安全区块中的固定规则（xray 等）没有任何按钮——避免出现“能点、点了却被拒绝”的按钮。
    """
    if not NAME_RE.fullmatch(name):
        return []
    view = view or {}
    if name in [n for n, _ in view.get("safety", [])]:
        return []
    reload_tip = "修改名单后 dae 会重新加载，正在走代理的程序会短暂断线并自动重连。"
    if status == STATUS_PROXY:
        return [("移除代理", ["remove", name], True, "从代理名单移除，之后直连。" + reload_tip)]
    if status == STATUS_DIRECT:
        return [("取消保护", ["unprotect", name], True, "从直连保护移除，之后按默认规则直连。" + reload_tip)]
    if is_blacklisted(name):
        add = ("加入代理", ["add", name], False,
               "“%s”是通用运行时名称，不能加入代理名单（会把所有同名程序一起代理）。请使用该应用自身的代理设置。" % name)
    else:
        add = ("加入代理", ["add", name], True, "加入代理名单。" + reload_tip)
    return [add, ("直连保护", ["protect", name], True, "加入直连保护（must_direct），保证它永远直连。" + reload_tip)]


