        rows.append({"name": a["name"], "pids": len(a["pids"]), "conns": a["conns"],
                     "samples": list(a["samples"]), "status": status_of(a["name"], view)})
    kids = unproxied_children(view)
    by_name = {r["name"]: r for r in rows}
    for name in sorted(kids):
        parent = "父进程：%s" % "、".join(sorted(kids[name]["parents"]))
        if name in by_name:
            by_name[name]["status"] = STATUS_CHILD
            by_name[name]["samples"].insert(0, parent)
        else:
            rows.append({"name": name, "pids": len(kids[name]["pids"]), "conns": 0,
                         "samples": [parent], "status": STATUS_CHILD})
    return rows


