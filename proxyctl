def merge_recent(history, rows, now, keep):
    """GUI 用：把最近 keep 秒内出现过、但当前快照中已消失的进程保留在表格中。

    短连接（登录、检查更新）常常落在两次快照之间，保留一段时间能多抓住一些。
    history 为 {进程名: (行, 最后出现时间)}，会被原地更新。
    被保留的行 conns 为 0，并带有 "gone" 字段（已消失的秒数）。
    """
    names = set()
    for r in rows:
        names.add(r["name"])
        if r["conns"] > 0:
            history[r["name"]] = (dict(r), now)
    out = list(rows)
    for name, (r, seen) in sorted(history.items()):
        if name in names:
            continue
        age = now - seen
        if age > keep:
            del history[name]
            continue
        old = dict(r)
        old["conns"] = 0
        old["gone"] = age
        out.append(old)
    return out


