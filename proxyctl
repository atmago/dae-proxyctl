    def toast(self, text, detail=None, title=None, error=False):
        """轻量提示；有详情时带一个“详情”按钮。没有 libadwaita 时退回对话框。"""
        if not self.Adw:
            self.dialog(title or text, detail or text, error=error)
            return
        t = self.Adw.Toast.new(text)
        t.set_timeout(5)
        if detail:
            t.set_button_label("详情")
            t.connect("button-clicked", lambda *_: self.dialog(title or text, detail, error=error))
        self.toasts.add_toast(t)

    @staticmethod
    def chain_down():
        st = load_chain_state()
        return int(st.get("fails", 0)) >= 2 and time.time() - st.get("time", 0) <= 600

    @staticmethod
    def chain_state():
        st = load_chain_state()
        if not st or time.time() - st.get("time", 0) > 600:
            return "unknown", "链路：未知（定时器未运行？）"
        if st.get("ok") and int(st.get("slow", 0)) >= SLOW_STREAK:
            return "warn", "链路：很慢（%.1f 秒）" % st.get("elapsed", 0)
        if st.get("ok"):
            return "ok", "链路：正常（%.1f 秒）" % st.get("elapsed", 0)
        if int(st.get("fails", 0)) >= 2:
            return "bad", "链路：不通"
        return "warn", "链路：探测失败 1 次"

    def refresh_status(self):
        state = service_state()
        listening = socks_listening(0.5)
        cores = [n for n in CORE_NAMES if n in running_processes()]
        # 显示正在监听 SOCKS 端口的内核（两个内核同时运行时，只有它在干活）；看不到时退回正在运行的内核
        shown = (sorted({n for n, _ in (listener_procs() or [])}) if listening else []) or cores
        chain_level, chain_text = self.chain_state()
        esc = self.GLib.markup_escape_text
        facts = [
            ("ok" if state == "active" else "bad", "dae %s" % SERVICE_STATE_ZH.get(state, state)),
            ("ok" if listening else "bad", "SOCKS %s %s" % (socks_str(), "监听中" if listening else "未监听")),
            ("ok" if shown else "bad", "、".join(self.core_pill(n) for n in shown) if shown else "代理核心未运行"),
            (chain_level, chain_text.replace("：", " ", 1)),
        ]
        markup = "　".join('<span foreground="%s">●</span> %s' % (GUI_DOT[lv], t if i == 2 else esc(t, -1))
                          for i, (lv, t) in enumerate(facts))

        if state != "active":
            level, title, hint = ("bad", "dae 未运行，名单中的程序正在直连",
                                  "代理名单中的程序此刻直连外网，会暴露真实 IP（故障即放行）。请执行 sudo systemctl start dae")
        elif not listening:
            level, title, hint = ("bad", "SOCKS5 未监听，名单中的程序无法联网",
                                  "dae 已把名单中的程序交给 %s，但那里没有程序在监听（故障即断开）。请检查 v2rayN / xray。"
                                  % socks_str())
        elif self.chain_down():
            level, title, hint = ("bad", "代理链路不通",
                                  "xray 连不上节点，名单中的程序无法联网（故障即断开）。请在 v2rayN 中测试或更换节点。")
        elif chain_level == "warn" and "很慢" in chain_text:
            level, title, hint = ("warn", "代理链路很慢",
                                  "Signal 等需要长连接的应用可能反复显示离线。建议在 v2rayN 中测试延迟并更换节点。")
        elif chain_level == "warn":
            level, title, hint = ("warn", "链路探测失败 1 次", "健康检查正在每 15 秒复查，偶发一次通常是节点抖动。")
        elif not cores:
            level, title, hint = ("warn", "没有找到代理核心进程",
                                  "SOCKS 端口在监听，但没有运行 %s 中的任何一个。如果你用的是其他代理核心，可以忽略。"
                                  % "、".join(CORE_NAMES))
        elif chain_level == "unknown":
            level, title, hint = ("unknown", "代理已就绪，链路状态未知",
                                  "没有读到健康检查的结果，定时器可能没有运行：systemctl --user enable --now proxyctl-check.timer")
        else:
            level, title, hint = "ok", "代理工作正常", ""
        self.alert = level in ("bad", "warn")
        sig = (level, title, hint, markup)
