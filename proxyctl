    def on_manual(self, sub):
        name = self.entry.get_text().strip()
        try:
            validate_name(name)
            if sub == "add" and is_blacklisted(name):
                raise ProxyctlError(blacklist_reason(name))
        except ProxyctlError as e:
            self.dialog("无法添加", str(e), error=True)
            return
        self.priv([sub, name])

    def priv(self, subargs):
        if self.busy:
            return
        exe = self_bin()
        if not os.path.exists(exe):
            self.dialog("未安装", "找不到 %s，请先执行 sudo ./install.sh。" % exe, error=True)
            return
        self.busy = True
        self.content.set_sensitive(False)
        self.set_status("等待授权：proxyctl %s" % " ".join(subargs), busy=True)
        cmd = [pkexec_bin(), exe] + subargs

        def work():
            rc, out = run_cmd(cmd, timeout=300)
            if rc in (126, 127) and not out.strip():
                out = ""
            self.GLib.idle_add(self.priv_done, subargs, rc, out)
        threading.Thread(target=work, daemon=True).start()

    def priv_done(self, subargs, rc, out):
        self.busy = False
        self.content.set_sensitive(True)
        self.set_status("")
        title = "proxyctl %s %s" % (" ".join(subargs), "成功" if rc == 0 else "失败")
        if rc in (126, 127) and not out.strip():
            self.toast("已取消授权，没有做任何修改")
        elif rc == 0:
            if subargs[0] in ("add", "protect"):
                self.entry.set_text("")
            if subargs[0] == "dns":
                msg = "已%s DNS 防泄漏" % ("开启" if subargs[-1] == "on" else "关闭")
            else:
                msg = "%s：%s" % (GUI_DONE.get(subargs[0], "已完成"), " ".join(subargs[1:]))
            if "重新加载" in out:
                msg += "，相关程序会短暂重连"
            self.toast(msg, detail=out.strip() or None, title=title)
        else:
            self.dialog(title, out.strip() or "(无输出)", error=True)
        self.force_refresh()
        return False

    def pick_file(self, save, title, cb, name=None):
        """选择文件，选好后 cb(路径)。GTK ≥ 4.10 用 FileDialog，否则用 FileChooserNative。"""
        Gtk = self.Gtk
        if self.ver == 4 and hasattr(Gtk, "FileDialog"):
            fd = Gtk.FileDialog(title=title, modal=True)
            flt = Gtk.FileFilter()
            flt.set_name("JSON 文件")
            flt.add_pattern("*.json")
            filters = self.Gio.ListStore.new(Gtk.FileFilter)
            filters.append(flt)
            fd.set_filters(filters)
            if name:
                fd.set_initial_name(name)

            def done(dlg, res):
                try:
                    f = (dlg.save_finish if save else dlg.open_finish)(res)
                except self.GLib.Error:
                    return  # 用户取消
                if f is not None and f.get_path():
                    cb(f.get_path())
            (fd.save if save else fd.open)(self.win, None, done)
            return
        action = Gtk.FileChooserAction.SAVE if save else Gtk.FileChooserAction.OPEN
        fc = Gtk.FileChooserNative.new(title, self.win, action, None, None)
        if name:
            fc.set_current_name(name)
            if self.ver == 3:
                fc.set_do_overwrite_confirmation(True)

        def resp(dlg, r):
            if r == Gtk.ResponseType.ACCEPT:
                f = dlg.get_file()
                if f is not None and f.get_path():
                    cb(f.get_path())
            self.chooser = None
        fc.connect("response", resp)
        self.chooser = fc  # 保持引用，否则对话框会被回收
        fc.show()

    def selectable_links(self, root):
        """让“详细信息”里含 GitHub 地址的说明文字可以选中复制（链接本身点击即可打开，右键可复制链接地址）。
        libadwaita 没有提供这个选项，只能在它的控件树里找到那个标签；找不到也不影响使用。"""
        stack = [root]
        while stack:
            w = stack.pop()
            if isinstance(w, self.Gtk.Label) and HOMEPAGE in (w.get_label() or ""):
                w.set_selectable(True)
            c = w.get_first_child()
            while c is not None:
                stack.append(c)
                c = c.get_next_sibling()
        return False  # 作为 idle 回调只执行一次

