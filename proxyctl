EXPORT_FORMAT = "proxyctl-lists"
EXPORT_VERSION = 1
IMPORT_MAX_BYTES = 1 << 20


def export_data(view):
    return {
        "format": EXPORT_FORMAT,
        "version": EXPORT_VERSION,
        "exported": datetime.datetime.now().isoformat(timespec="seconds"),
        "proxy": list(view.get("proxy", [])),
        "direct": list(view.get("direct", [])),
    }


def export_text(view):
    return json.dumps(export_data(view), ensure_ascii=False, indent=2) + "\n"


def parse_import(raw):
    """解析导出文件，返回 {"proxy": [...], "direct": [...]}；任何不合法之处都整体拒绝。"""
    if isinstance(raw, bytes):
        if len(raw) > IMPORT_MAX_BYTES:
            raise ProxyctlError("导入文件过大（超过 1 MB），不像是 proxyctl 导出的名单。")
        try:
            raw = raw.decode("utf-8-sig")
        except UnicodeDecodeError:
            raise ProxyctlError("导入文件不是 UTF-8 编码。")
    try:
        data = json.loads(raw)
    except ValueError as e:
        raise ProxyctlError("导入文件不是合法的 JSON：%s" % e)
    if not isinstance(data, dict) or not ("proxy" in data or "direct" in data):
        raise ProxyctlError("导入文件中没有 proxy / direct 名单，不是 proxyctl 导出的文件。")
    if data.get("format", EXPORT_FORMAT) != EXPORT_FORMAT:
        raise ProxyctlError("导入文件格式为“%s”，不是 %s。" % (data.get("format"), EXPORT_FORMAT))
    ver = data.get("version", EXPORT_VERSION)
    if not isinstance(ver, int) or ver > EXPORT_VERSION:
        raise ProxyctlError("导入文件版本为 %r，当前 proxyctl 只支持到 %d，请先升级 proxyctl。" % (ver, EXPORT_VERSION))
    out = {}
    for key in ("proxy", "direct"):
        names = data.get(key, [])
        if not isinstance(names, list):
            raise ProxyctlError("导入文件中的 %s 必须是进程名列表。" % key)
        for n in names:
            validate_name(n)
        out[key] = _dedupe(names)
    both = [n for n in out["proxy"] if n in out["direct"]]
    if both:
        raise ProxyctlError("导入文件自相矛盾：%s 同时出现在 proxy 和 direct 中，未做任何修改。" % "、".join(both))
    return out


def import_plan(cur_proxy, cur_direct, data, replace=False):
    """计算导入后的名单。返回 (新 proxy, 新 direct, 消息)。只依赖名单，GUI 也用它做预览。"""
    msgs = []
    proxy = [] if replace else list(cur_proxy)
    direct = [] if replace else list(cur_direct)
    for n in data["direct"]:
        if n in SAFETY_NAMES:
            if SAFETY_NAMES[n] != "must_direct":
                msgs.append("跳过：“%s”在安全区块中走代理（用于自检），不能改为直连。" % n)
            continue  # 已在安全区块中直连保护
        if n in proxy:
            msgs.append("跳过：“%s”当前在代理名单中，不改为直连保护（如确需，请先 proxyctl remove %s）。" % (n, n))
            continue
        if n not in direct:
            direct.append(n)
    for n in data["proxy"]:
        if n in SAFETY_NAMES:
            if SAFETY_NAMES[n] != "proxy":
                msgs.append("跳过：“%s”是代理核心，在安全区块中必须直连，走代理会形成回环。" % n)
            continue
        if is_blacklisted(n):
            msgs.append("跳过：“%s”是通用运行时名称，不能加入代理名单。" % n)
            continue
        if n in direct:
            msgs.append("跳过：“%s”当前在直连保护名单中，不改为代理（如确需，请先 proxyctl unprotect %s）。" % (n, n))
            continue
        if n not in proxy:
            proxy.append(n)
    for key, old, new in (("代理名单", cur_proxy, proxy), ("直连保护", cur_direct, direct)):
        added = [n for n in new if n not in old]
        gone = [n for n in old if n not in new]
        if added:
            msgs.append("%s新增 %d 个：%s" % (key, len(added), "、".join(added)))
        if gone:
            msgs.append("%s移除 %d 个：%s" % (key, len(gone), "、".join(gone)))
        for n in added:
            if long_name_warning(n):
                msgs.append(long_name_warning(n))
    return proxy, direct, msgs


def op_import(text, data, replace=False):
    parsed = Parsed(text)
    _require_init(parsed)
    msgs = []
    lists = current_lists(parsed, msgs)
    proxy, direct, plan_msgs = import_plan(parsed.names("proxy"), parsed.names("direct"), data, replace)
    msgs.extend(plan_msgs)
    lists["proxy"] = [(n, "proxy") for n in proxy]
    lists["direct"] = [(n, "must_direct") for n in direct]
    return render(parsed, lists), msgs


