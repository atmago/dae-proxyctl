def process_table():
    """返回 {pid: (进程名, 父 pid)}，读取 /proc/*/stat（非 root 也可读所有进程）。"""
    table = {}
    try:
        entries = os.listdir(proc_dir())
    except OSError:
        return table
    for e in entries:
        if not e.isdigit():
            continue
        base = os.path.join(proc_dir(), e)
        try:
            with open(os.path.join(base, "stat"), "r", encoding="utf-8", errors="replace") as f:
                data = f.read()
            # 进程名在括号中，本身可能含空格或括号，所以取最后一个 ")"
            comm = data[data.index("(") + 1:data.rindex(")")]
            ppid = int(data[data.rindex(")") + 2:].split()[1])
        except (OSError, ValueError, IndexError):
            try:
                with open(os.path.join(base, "comm"), "r", encoding="utf-8", errors="replace") as f:
                    comm, ppid = f.read().strip(), 0
            except OSError:
                continue
        table[int(e)] = (comm, ppid)
    return table


def running_processes():
    """返回 {进程名: [pid, ...]}。"""
    out = {}
    for pid, (comm, _) in process_table().items():
        out.setdefault(comm, []).append(pid)
    return out


def unproxied_children(view, table=None):
    """找出代理名单中程序的子孙进程里，名字不同且不在任何名单中的进程。

    pname 只按进程名匹配：ChatGPT 在名单中，它的子进程 codex 却不会因此走代理。
    这类子进程往往只在登录、同步时短暂联网，ss 快照很难抓到，所以直接从进程树找。
    遇到这类进程后不再向下查找（它的子进程与名单程序已隔了一层）；
    通用运行时名称（bash、python3 等）不能加入代理名单，也不列出。
    返回 {进程名: {"name", "parents": set, "pids": set}}。
    """
    if not view:
        return {}
    if table is None:
        table = process_table()
    safety = view.get("safety", [])
    proxied = {n[:COMM_MAX] for n in view.get("proxy", [])}
    proxied |= {n[:COMM_MAX] for n, o in safety if o == "proxy"}
    listed = set(proxied)
    listed |= {n[:COMM_MAX] for n in view.get("direct", [])}
    listed |= {n[:COMM_MAX] for n, _ in safety}
    listed |= {n[:COMM_MAX] for n, _ in view.get("unmanaged_pname", [])}
    children = {}
    for pid, (_, ppid) in table.items():
        children.setdefault(ppid, []).append(pid)
    found = {}
    for pid, (comm, _) in table.items():
        if comm not in proxied:
            continue
        stack = list(children.get(pid, []))
        while stack:
            child = stack.pop()
            ccomm = table[child][0]
            if ccomm in proxied:
                continue  # 它自己也会作为起点被检查
            if ccomm in listed or not NAME_RE.fullmatch(ccomm) or is_blacklisted(ccomm):
                continue
            item = found.setdefault(ccomm, {"name": ccomm, "parents": set(), "pids": set()})
            item["parents"].add(comm)
            item["pids"].add(child)
    return found


def process_running(name):
    return name[:COMM_MAX] in running_processes()


# ---------------------------------------------------------------------------
# ss 输出解析
# ---------------------------------------------------------------------------

SS_USERS_RE = re.compile(r'\("((?:[^"\\]|\\.)*)",pid=(\d+),fd=\d+\)')


def split_addr(s):
    """把 ss 的“地址:端口”拆开，返回 (ip 对象或 None, 端口字符串)。"""
    if s.startswith("["):
        end = s.find("]")
        host, port = s[1:end], s[end + 2:]
    else:
        host, _, port = s.rpartition(":")
    host = host.split("%", 1)[0]
    if host in ("*", ""):
        return None, port
    try:
        ip = ipaddress.ip_address(host)
    except ValueError:
        return None, port
    if ip.version == 6 and ip.ipv4_mapped:
        ip = ip.ipv4_mapped
    return ip, port


def is_local_ip(ip):
    return (ip is None or ip.is_loopback or ip.is_private or ip.is_link_local
            or ip.is_multicast or ip.is_unspecified or ip.is_reserved)


def parse_ss(output):
    """解析 `ss -tunpH` 输出，返回连接列表。"""
    conns = []
    for line in output.splitlines():
        parts = line.split()
        if len(parts) < 6 or parts[0] not in ("tcp", "udp", "raw", "sctp"):
            continue
        netid, st, local, peer = parts[0], parts[1], parts[4], parts[5]
        rest = " ".join(parts[6:])
        procs = [(n.replace('\\"', '"'), int(p)) for n, p in SS_USERS_RE.findall(rest)]
        ip, port = split_addr(peer)
        conns.append({"netid": netid, "state": st, "local": local, "peer": peer,
                      "peer_ip": ip, "peer_port": port, "procs": procs})
    return conns


def aggregate(conns, max_samples=3):
    """按进程名聚合联网中的连接（排除回环与局域网）。"""
    agg = {}
    for c in conns:
        if is_local_ip(c["peer_ip"]):
            continue
        names = {}
        for n, pid in c["procs"]:
            names.setdefault(n, set()).add(pid)
        if not names:
            names = {"(未知进程)": set()}
        ip = c["peer_ip"]
        sample = ("[%s]:%s" % (ip, c["peer_port"])) if ip.version == 6 else "%s:%s" % (ip, c["peer_port"])
        for n, pids in names.items():
            a = agg.setdefault(n, {"name": n, "pids": set(), "conns": 0, "samples": []})
            a["pids"].update(pids)
            a["conns"] += 1
            if sample not in a["samples"] and len(a["samples"]) < max_samples:
                a["samples"].append(sample)
    return sorted(agg.values(), key=lambda a: (-a["conns"], a["name"]))


def ss_connections():
    rc, out = run_cmd([ss_bin(), "-tunpH"], timeout=15)
    if rc != 0:
        raise ProxyctlError("执行 ss 失败：%s" % out.strip())
    return parse_ss(out)


def collect_connections(conns=None):
    return aggregate(ss_connections() if conns is None else conns)


