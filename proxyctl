_TTY = sys.stdout.isatty()


def color(text, code):
    return "\033[%sm%s\033[0m" % (code, text) if _TTY and not os.environ.get("NO_COLOR") else text


def disp_width(s):
    return sum(2 if unicodedata.east_asian_width(c) in "WF" else 1 for c in s)


def pad(s, width):
    return s + " " * max(0, width - disp_width(s))


def table(headers, rows):
    widths = [disp_width(h) for h in headers]
    for r in rows:
        for i, c in enumerate(r[:-1]):
            widths[i] = max(widths[i], disp_width(c))
    out = ["  ".join(pad(h, widths[i]) if i < len(headers) - 1 else h for i, h in enumerate(headers))]
    for r in rows:
        out.append("  ".join(pad(c, widths[i]) if i < len(r) - 1 else c for i, c in enumerate(r)))
    return "\n".join(out)


