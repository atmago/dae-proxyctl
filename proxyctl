    # -- GTK3/GTK4 兼容辅助 ------------------------------------------------------
    def put(self, container, child):
        Gtk = self.Gtk
        if isinstance(container, Gtk.Box):
            if self.ver == 4:
                container.append(child)
            else:
                container.pack_start(child, False, True, 0)
        elif isinstance(container, Gtk.ListBox):
            if self.ver == 4:
                container.append(child)
            else:
                container.add(child)
        elif self.ver == 4:
            container.set_child(child)
        else:
            container.add(child)
        return child

    def clear(self, container):
        if self.ver == 4:
            child = container.get_first_child()
            while child is not None:
                nxt = child.get_next_sibling()
                container.remove(child)
                child = nxt
        else:
            for child in container.get_children():
                container.remove(child)

    def css(self, widget, *classes, remove=()):
        for c in remove:
            if self.ver == 4:
                widget.remove_css_class(c)
            else:
                widget.get_style_context().remove_class(c)
        for c in classes:
            if self.ver == 4:
                widget.add_css_class(c)
            else:
                widget.get_style_context().add_class(c)
        return widget

    def show(self, w):
        if self.ver == 3:
            w.show_all()
        w.present()

    def box(self, vertical=False, spacing=6):
        o = self.Gtk.Orientation.VERTICAL if vertical else self.Gtk.Orientation.HORIZONTAL
        return self.Gtk.Box(orientation=o, spacing=spacing)

    def margins(self, w, top, end=None, bottom=None, start=None):
        end = top if end is None else end
        bottom = top if bottom is None else bottom
        start = end if start is None else start
        w.set_margin_top(top)
        w.set_margin_bottom(bottom)
        w.set_margin_start(start)
        w.set_margin_end(end)
        return w

    def label(self, text="", xalign=0.0, wrap=False, ellipsize=False, classes=(), markup=False):
        lb = self.Gtk.Label()
        if markup:
            lb.set_markup(text)
        else:
            lb.set_text(text)
        lb.set_xalign(xalign)
        if wrap:
            lb.set_wrap(True) if self.ver == 4 else lb.set_line_wrap(True)
        if ellipsize:
            lb.set_ellipsize(self.Pango.EllipsizeMode.END)
            lb.set_hexpand(True)
        self.css(lb, *classes)
        return lb

    def button(self, text, cb, *data, tooltip=None, icon=None, flat=False):
        Gtk = self.Gtk
        if icon:
            b = Gtk.Button.new_from_icon_name(icon) if self.ver == 4 else \
                Gtk.Button.new_from_icon_name(icon, Gtk.IconSize.BUTTON)
        else:
            b = Gtk.Button(label=text)
        b.connect("clicked", lambda _w: cb(*data))
        if tooltip:
            b.set_tooltip_text(tooltip)
        if flat:
            self.css(b, "flat")
        b.set_valign(Gtk.Align.CENTER)
        return b

    def image(self, icon, size):
        Gtk = self.Gtk
        img = Gtk.Image.new_from_icon_name(icon) if self.ver == 4 else \
            Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.DIALOG)
        img.set_pixel_size(size)
        return img

    def set_icon(self, img, icon):
        if self.ver == 4:
            img.set_from_icon_name(icon)
        else:
            img.set_from_icon_name(icon, self.Gtk.IconSize.DIALOG)

    def clamp(self, child):
        """限制内容最大宽度并居中；没有 libadwaita 时直接铺满。"""
        if self.Adw:
            c = self.Adw.Clamp(maximum_size=self.CLAMP, tightening_threshold=self.CLAMP - 160)
            c.set_child(child)
            return c
        return child

    def scrolled(self, child):
        sw = self.Gtk.ScrolledWindow()
        sw.set_vexpand(True)
        sw.set_hexpand(True)
        # 不出现横向滚动条：过长的内容省略显示，按钮始终留在窗口内
        sw.set_policy(self.Gtk.PolicyType.NEVER, self.Gtk.PolicyType.AUTOMATIC)
        self.put(sw, child)
        return sw

    def group(self, parent, title, count=None, desc=None):
        """带标题的卡片列表（GNOME 设置里那种圆角分组），返回 ListBox。"""
        Gtk = self.Gtk
        head = self.box(spacing=8)
        head.set_margin_top(14)
        head.set_margin_start(4)
        self.put(head, self.label(title, classes=("group-title",)))
        if count is not None:
            self.put(head, self.label(str(count), classes=("group-count",)))
        self.put(parent, head)
        if desc:
            d = self.put(parent, self.label(desc, wrap=True, classes=("caption",)))
            d.set_margin_start(4)
        lb = Gtk.ListBox()
        lb.set_selection_mode(Gtk.SelectionMode.NONE)
        self.css(lb, "boxed-list" if self.Adw else "card-list")
        lb.set_margin_top(6)
        self.put(parent, lb)
        return lb

    def row(self, lb, title, subtitle=None, tag=None, suffix=(), dim=False, sub_markup=False, tip=None, wrap=False):
        """列表中的一行：标题（可带状态标签）＋副标题，右侧放按钮等。"""
        Gtk = self.Gtk
        r = Gtk.ListBoxRow()
        r.set_activatable(False)
        hb = self.margins(self.box(spacing=12), 9, 12, 9, 14)
        hb.set_size_request(-1, 38)
        text = self.box(vertical=True, spacing=3)
        text.set_hexpand(True)
        text.set_valign(Gtk.Align.CENTER)
        line = self.box(spacing=8)
        self.put(line, self.label(title, classes=("row-title",)))
        for tg in ([tag] if isinstance(tag, tuple) else tag or []):
            t = self.put(line, self.label(tg[0], classes=("tag", tg[1])))
            t.set_valign(Gtk.Align.CENTER)
            if tg[2:]:
                t.set_tooltip_text(tg[2])
        self.put(text, line)
        if subtitle:
            s = self.put(text, self.label(subtitle, ellipsize=not wrap, wrap=wrap, classes=("caption",),
                                          markup=sub_markup))
            if tip:
                s.set_tooltip_text(tip)
        self.put(hb, text)
        for w in suffix:
            self.put(hb, w)
        if dim:
            self.css(text, "gone")
        self.put(r, hb)
        self.put(lb, r)
        return r

    def load_css(self):
        Gtk, Gdk = self.Gtk, self.Gdk
        css = GUI_CSS
        for k, v in (GUI_COLORS_ADW if self.Adw else GUI_COLORS_PLAIN).items():
            css = css.replace(k, v)
        provider = Gtk.CssProvider()
        try:
            if hasattr(provider, "load_from_string"):
                provider.load_from_string(css)
            elif self.ver == 4:
                provider.load_from_data(css, -1)
            else:
                provider.load_from_data(css.encode("utf-8"))
            prio = Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
            if self.ver == 4:
                Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), provider, prio)
            else:
                Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), provider, prio)
        except Exception:  # noqa  样式加载失败不影响功能
            pass

    def copy_text(self, text):
        try:
            if self.ver == 4:
                self.win.get_clipboard().set_content(self.Gdk.ContentProvider.new_for_value(text))
            else:
                self.Gtk.Clipboard.get(self.Gdk.SELECTION_CLIPBOARD).set_text(text, -1)
        except Exception:  # noqa
            pass

    def shortcut(self, name, accel, cb):
        act = self.Gio.SimpleAction.new(name, None)
        act.connect("activate", lambda *_: cb())
        self.app.add_action(act)
        if accel:
            self.app.set_accels_for_action("app." + name, [accel])

