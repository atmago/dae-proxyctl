def own_dns_sections(parsed):
    """不属于 proxyctl 的顶层 dns 区块所在行号。"""
    mine = set()
    if "dns" in parsed.regions:
        b, e = parsed.regions["dns"]
        mine = set(range(b, e + 1))
    out = []
    depth = 0
    for i, line in enumerate(parsed.lines):
        code = code_part(line)
        if depth == 0 and re.match(r"^\s*dns\s*\{", code) and i not in mine:
            out.append(i)
        depth += code.count("{") - code.count("}")
    return out


def op_dns_protect(text, on):
    """开启 / 关闭“国外域名的 DNS 经代理查询”。"""
    parsed = Parsed(text)
    _require_init(parsed)
    msgs = []
    text = render(parsed, current_lists(parsed, msgs))
    parsed = Parsed(text)
    lines = list(parsed.lines)
    nl = parsed.nl
    if on:
        if parsed.dns_protected:
            msgs.append("DNS 防泄漏已经开启，无需重复开启。")
            return text, msgs
        own = own_dns_sections(parsed)
        if own:
            raise ProxyctlError("配置第 %d 行已有你自己写的 dns 区块。proxyctl 不改动你自己的 DNS 设置，"
                                "请手工在其中加入经代理查询的上游，或删除它后再开启。" % (own[0] + 1))
        indent = parsed.indent
        route = [indent + BEGIN_MARK["dns-route"] + nl, indent + PROTECT_ROUTE_RULE + nl,
                 indent + END_MARK["dns-route"] + nl]
        at = parsed.blocks["proxy"][1] + 1
        lines[at:at] = route
        if lines and not lines[-1].endswith("\n"):
            lines[-1] += nl
        lines.append(nl)
        lines.append(BEGIN_MARK["dns"] + nl)
        lines.extend(l + nl for l in PROTECT_DNS_BLOCK.split("\n"))
        lines.append(END_MARK["dns"] + nl)
        msgs.append("已开启 DNS 防泄漏：国内和局域网域名照旧查询原来的 DNS，其余域名由 dae 经代理向 %s 查询，"
                    "运营商看不到这些查询。" % PROTECT_DNS_IP)
        msgs.append("注意：这对全系统生效；代理不可用时，国外域名会暂时解析失败。")
    else:
        if not parsed.dns_protected:
            msgs.append("DNS 防泄漏本来就没有开启。")
            return text, msgs
        for r in ("dns", "dns-route"):  # 先删后面的，前面的行号不变
            b, e = parsed.regions[r]
            if r == "dns":
                if e + 1 < len(lines) and is_blank(lines[e + 1]):
                    e += 1
                elif b > 0 and is_blank(lines[b - 1]):
                    b -= 1
            del lines[b:e + 1]
        msgs.append("已关闭 DNS 防泄漏：DNS 恢复为原来的走法。")
    return "".join(lines), msgs


