class Checker(object):
    def __init__(self, quiet):
        self.quiet = quiet
        self.results = []
        self.slow = None  # 代理链路“很慢”的说明（需要单独提醒，但不算故障）

    def add(self, level, msg):
        self.results.append((level, msg))
        if self.quiet and level not in ("WARN", "FAIL"):
            return
        tag = {"OK": color("[ OK ]", "32"), "WARN": color("[WARN]", "33"),
               "FAIL": color("[FAIL]", "1;31"), "INFO": "[INFO]", "SKIP": "[SKIP]"}[level]
        if level == "FAIL":
            msg = color(msg, "1;31")
        print("%s %s" % (tag, msg))

    def fails(self):
        return [m for l, m in self.results if l == "FAIL"]

    def exit_code(self):
        levels = {l for l, _ in self.results}
        return 2 if "FAIL" in levels else (1 if "WARN" in levels else 0)


def listener_procs():
    """用 ss 找出 SOCKS 端口的监听进程：[(名字, pid), ...]；看不到进程信息时为 []，没有监听者时为 None。"""
    host, port = socks_addr()
    rc, out = run_cmd([ss_bin(), "-ltnpH"], timeout=15)
    if rc != 0:
        return None
    for line in out.splitlines():
        parts = line.split()
        if len(parts) < 4:
            continue
        local = parts[3]
        _, p = split_addr(local)
        if p == str(port):
            return SS_USERS_RE.findall(" ".join(parts[5:]))
    return None


def listener_process():
    """SOCKS 端口监听进程的描述字符串，没有监听者时为 None。"""
    procs = listener_procs()
    if procs is None:
        return None
    if procs:
        return ", ".join("%s(pid %s)" % (n, pid) for n, pid in procs)
    return "未知进程（非 root 看不到其他用户的进程）"


def default_route_ifaces():
    ifaces = set()
    try:
        with open("/proc/net/route") as f:
            for line in f.readlines()[1:]:
                p = line.split()
                if len(p) > 2 and p[1] == "00000000":
                    ifaces.add(p[0])
    except OSError:
        pass
    try:
        with open("/proc/net/ipv6_route") as f:
            for line in f:
                p = line.split()
                if len(p) >= 10 and p[0] == "0" * 32 and p[1] == "00" and p[9] != "lo":
                    ifaces.add(p[9])
    except OSError:
        pass
    return ifaces


def global_ipv6(ifaces):
    found = []
    try:
        with open("/proc/net/if_inet6") as f:
            for line in f:
                p = line.split()
                if len(p) < 6 or p[5] not in ifaces or p[3] != "00":
                    continue
                ip = ipaddress.ip_address(":".join(p[0][i:i + 4] for i in range(0, 32, 4)))
                if ip in ipaddress.ip_network("2000::/3"):
                    found.append((p[5], str(ip)))
    except OSError:
        pass
    return found


def probe_url():
    return _env("PROXYCTL_PROBE_URL", "https://www.gstatic.com/generate_204")


def chain_interval():
    """链路正常时两次探测的最小间隔（秒）；失败后每次检查都会复查。"""
    try:
        return max(0.0, float(_env("PROXYCTL_CHAIN_INTERVAL", "120")))
    except ValueError:
        return 120.0


def chain_state_path():
    base = os.environ.get("XDG_RUNTIME_DIR") or os.path.join(os.path.expanduser("~"), ".cache")
    return os.path.join(base, "proxyctl-chain.json")


def load_chain_state():
    try:
        with open(chain_state_path()) as f:
            data = json.load(f)
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def probe_chain():
    """真正经 SOCKS5 发一个很小的请求，确认 xray → 节点 → 外网 整条链路可用。
    只要拿到 HTTP 响应就算通（curl 不带 -f 时，任何 HTTP 状态码都返回 0）。"""
    t0 = time.monotonic()
    rc, out = run_cmd([curl_bin(), "-x", "socks5h://%s" % socks_str(), "-sS", "-o", "/dev/null",
                       "-w", "%{http_code}", "--max-time", "15", probe_url()],
                      timeout=25, env=_clean_env())
    elapsed = time.monotonic() - t0
    if rc == 0:
        return True, "HTTP %s，耗时 %.1f 秒" % (out.strip()[-3:], elapsed), elapsed
    return False, "curl 退出码 %d：%s" % (rc, out.strip()[:160]), elapsed


def slow_seconds():
    """单次链路探测超过这个秒数记为“偏慢”。"""
    try:
        return max(0.0, float(_env("PROXYCTL_SLOW_SECONDS", "3")))
    except ValueError:
        return 3.0


SLOW_STREAK = 3  # 连续这么多次偏慢才警告（换节点后第一次连接本来就可能要几秒）


CHAIN_FAIL = ("代理链路不通：dae、SOCKS5 端口和 xray 都在运行，但经 SOCKS5 连续无法访问外网"
              "（节点不可达、线路被阻断或 v2rayN 配置有误）。名单中的程序此刻无法联网（故障即断开）。"
              "请在 v2rayN 中测试或更换节点。")


def check_chain(ck, use_cache, core=None):
    """链路探测。use_cache=True（定时器）时，最近一次探测成功、不慢且未超过间隔就不重复探测。
    连续 2 次失败才判 FAIL，避免节点偶发抖动误报；FAIL 文案固定，保证通知去重有效。
    连续 SLOW_STREAK 次成功但耗时超过 slow_seconds() 时给出“很慢”警告（ck.slow），
    因为节点很慢时 Signal 这类维持长连接的应用会反复显示离线，而普通检查全部正常。"""
    last = load_chain_state()
    now = time.time()
    age = now - last.get("time", 0)
    if use_cache and last.get("ok") and not last.get("slow") and 0 <= age < chain_interval():
        ck.add("OK", "代理链路正常（%d 秒前探测，耗时 %.1f 秒）。" % (age, last.get("elapsed", 0)))
        return
    ok, detail, elapsed = probe_chain()
    fails = 0 if ok else int(last.get("fails", 0)) + 1
    is_slow = ok and elapsed > slow_seconds()
    slow = int(last.get("slow", 0)) + 1 if is_slow else 0
    try:
        os.makedirs(os.path.dirname(chain_state_path()), exist_ok=True)
        with open(chain_state_path(), "w") as f:
            json.dump({"ok": ok, "time": now, "fails": fails, "slow": slow, "elapsed": round(elapsed, 2),
                       "detail": detail}, f, ensure_ascii=False)
    except OSError:
        pass
    record_chain_sample(now, ok, elapsed, core)
    if not ok:
        if fails >= 2:
            ck.add("FAIL", CHAIN_FAIL)
        else:
            ck.add("WARN", "代理链路探测失败 1 次（%s），稍后复查；连续失败才会报警。" % detail)
    elif slow >= SLOW_STREAK:
        ck.slow = ("代理链路很慢：连续 %d 次经 SOCKS5 访问外网都超过 %g 秒（最近一次 %.1f 秒，正常应在 1 秒左右）。"
                   "Signal 等需要保持长连接的应用可能反复显示离线。建议在 v2rayN 中测试延迟并更换节点。"
                   % (slow, slow_seconds(), elapsed))
        ck.add("WARN", ck.slow)
    elif slow:
        ck.add("OK", "代理链路可用但偏慢（%s，连续第 %d 次），继续观察。" % (detail, slow))
    else:
        ck.add("OK", "代理链路正常：经 SOCKS5 访问 %s 成功（%s）。" % (probe_url(), detail))


# ---- 链路延迟记录 ----------------------------------------------------------------
# 每次真正发出的链路探测（定时器正常时约 2 分钟一次，异常时 15 秒一次）追加一行 JSON：
# {"t": 时间戳, "ok": 1/0, "s": 耗时秒数, "core": SOCKS 监听进程名}。保存在用户目录，重启后仍在。
HISTORY_DAYS = 7
HISTORY_GAP = 600  # 两次记录相隔超过这么多秒视为中断（休眠、关机或定时器没运行），曲线在此断开


def history_path():
    base = os.environ.get("XDG_STATE_HOME") or os.path.join(os.path.expanduser("~"), ".local", "state")
    return _env("PROXYCTL_HISTORY", os.path.join(base, "proxyctl", "chain-history.jsonl"))


def record_chain_sample(now, ok, elapsed, core):
    """追加一条探测记录；以 root 运行（sudo proxyctl check）时不记录，免得写进 root 的主目录。
    文件超过 256 KB 且最早一条已超过保留期时，重写一次，只保留最近 HISTORY_DAYS 天。"""
    if os.geteuid() == 0:
        return
    path = history_path()
    line = json.dumps({"t": int(now), "ok": 1 if ok else 0, "s": round(elapsed, 2), "core": core or ""},
                      ensure_ascii=False) + "\n"
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "a") as f:
            f.write(line)
        if os.path.getsize(path) > 256 * 1024:
            cutoff = now - HISTORY_DAYS * 86400
            with open(path) as f:
                first = _history_record(f.readline())
            if first and first["t"] < cutoff - 3600:
                keep = [r for r in load_history(cutoff, path)]
                fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".history.")
                with os.fdopen(fd, "w") as f:
                    for r in keep:
                        f.write(json.dumps(r, ensure_ascii=False) + "\n")
                os.replace(tmp, path)
    except OSError:
        pass


def _history_record(line):
    try:
        r = json.loads(line)
        if isinstance(r, dict) and isinstance(r.get("t"), (int, float)):
            return {"t": int(r["t"]), "ok": 1 if r.get("ok") else 0,
                    "s": float(r.get("s") or 0), "core": str(r.get("core") or "")}
    except (ValueError, TypeError):
        pass
    return None


def load_history(since=0, path=None):
    """读取 since 之后的记录（按时间排序），坏行忽略。"""
    out = []
    try:
        with open(path or history_path(), encoding="utf-8", errors="replace") as f:
            for line in f:
                r = _history_record(line)
                if r and r["t"] >= since:
                    out.append(r)
    except OSError:
        pass
    out.sort(key=lambda r: r["t"])
    return out


def _quantile(values, q):
    v = sorted(values)
    if not v:
        return None
    return v[min(len(v) - 1, int(round(q * (len(v) - 1))))]


def history_stats(recs, slow=None):
    """汇总：次数、失败、成功探测耗时的中位数 / 90 分位 / 最大值、偏慢次数。"""
    slow = slow_seconds() if slow is None else slow
    times = [r["s"] for r in recs if r["ok"]]
    return {"count": len(recs), "fails": len(recs) - len(times),
            "median": _quantile(times, 0.5), "p90": _quantile(times, 0.9),
            "max": max(times) if times else None, "slow": sum(1 for t in times if t > slow)}


def history_episodes(recs, slow=None, gap=HISTORY_GAP):
    """把连续的异常探测（失败或偏慢）合并成时段；只有 1 次的偶发抖动不算。
    返回 [{"start", "end", "fails", "slow", "median", "max", "cores"}]，按时间排序。"""
    slow = slow_seconds() if slow is None else slow
    episodes, cur, last_t = [], None, None
    for r in recs:
        bad = not r["ok"] or r["s"] > slow
        if cur is not None and (not bad or r["t"] - last_t > gap):
            episodes.append(cur)
            cur = None
        if bad:
            if cur is None:
                cur = {"start": r["t"], "recs": []}
            cur["end"] = r["t"]
            cur["recs"].append(r)
        last_t = r["t"]
    if cur is not None:
        episodes.append(cur)
    out = []
    for e in episodes:
        if len(e["recs"]) < 2:
            continue
        st = history_stats(e["recs"], slow)
        out.append({"start": e["start"], "end": e["end"], "fails": st["fails"], "slow": st["slow"],
                    "median": st["median"], "max": st["max"],
                    "cores": sorted({r["core"] for r in e["recs"] if r["core"]})})
    return out


def history_core_switches(recs):
    """内核切换：[(时间, 原内核, 新内核)]。没有记录内核的探测跳过。"""
    out, prev = [], None
    for r in recs:
        if not r["core"]:
            continue
        if prev is not None and r["core"] != prev:
            out.append((r["t"], prev, r["core"]))
        prev = r["core"]
    return out


def history_buckets(recs, start, end, step):
    """按 step 秒分段统计，只返回有记录的时段：[(段起点, stats, 内核列表)]。"""
    groups = {}
    for r in recs:
        if start <= r["t"] < end:
            groups.setdefault(start + (r["t"] - start) // step * step, []).append(r)
    return [(k, history_stats(v), sorted({r["core"] for r in v if r["core"]})) for k, v in sorted(groups.items())]


def fmt_secs(v):
    return "—" if v is None else "%.1f 秒" % v


def fmt_clock(t, with_date=True):
    return datetime.datetime.fromtimestamp(t).strftime("%m-%d %H:%M" if with_date else "%H:%M")


def fmt_span(start, end):
    a = fmt_clock(start)
    if end - start < 60:
        return a
    b = fmt_clock(end, datetime.date.fromtimestamp(start) != datetime.date.fromtimestamp(end))
    return "%s–%s" % (a, b)


def describe_episode(e, slow=None):
    slow = slow_seconds() if slow is None else slow
    parts = []
    if e["fails"]:
        parts.append("失败 %d 次" % e["fails"])
    if e["slow"]:
        parts.append("%d 次超过 %g 秒（中位 %s，最慢 %s）" % (e["slow"], slow, fmt_secs(e["median"]),
                                                     fmt_secs(e["max"])))
    kind = "不通" if e["fails"] and not e["slow"] else ("很慢" if not e["fails"] else "不稳定")
    return kind, "，".join(parts) + ("；内核 %s" % "、".join(e["cores"]) if e["cores"] else "")


def history_summary_line(st):
    if not st["count"]:
        return "没有记录。"
    s = "共 %d 次探测" % st["count"]
    if st["median"] is not None:
        s += "：中位 %s，90%% 在 %s 以内，最慢 %s" % (fmt_secs(st["median"]), fmt_secs(st["p90"]), fmt_secs(st["max"]))
    return s + "；偏慢（超过 %g 秒）%d 次，失败 %d 次。" % (slow_seconds(), st["slow"], st["fails"])


def cmd_history(args):
    hours = max(1, min(args.hours, HISTORY_DAYS * 24))
    now = time.time()
    recs = load_history(now - hours * 3600)
    print("代理链路延迟记录（最近 %d 小时）" % hours)
    print("每条记录是健康检查定时器经 SOCKS5 新建一条连接访问外网的耗时：正常时约 2 分钟一次，异常时每 15 秒一次。")
    if not recs:
        print()
        print("没有记录（%s）。记录由定时器写入，请确认它在运行：" % history_path())
        print("  systemctl --user enable --now proxyctl-check.timer")
        return 0
    st = history_stats(recs)
    print(history_summary_line(st))
    last = recs[-1]
    if last["core"]:
        sw = history_core_switches(recs)
        print("当前内核：%s%s" % (last["core"], "（%s 从 %s 切换）" % (fmt_clock(sw[-1][0]), sw[-1][1]) if sw else ""))
    print()
    step = 3600 if hours <= 48 else 6 * 3600
    off = int(datetime.datetime.now().astimezone().utcoffset().total_seconds())  # 按本地整点分段
    start = (int(now - hours * 3600) + off) // step * step - off
    rows = []
    for k, b, cores in history_buckets(recs, start, now + 1, step):
        bar = "█" * min(20, int(round((b["median"] or 0) / 0.25))) if b["median"] is not None else ""
        rows.append([fmt_clock(k), str(b["count"]), fmt_secs(b["median"]), fmt_secs(b["max"]),
                     str(b["fails"]) if b["fails"] else "", "、".join(cores), bar])
    print(table(["时段", "次数", "中位", "最慢", "失败", "内核", "中位耗时（每格 0.25 秒）"], rows))
    eps = history_episodes(recs)
    sws = history_core_switches(recs)
    if eps or sws:
        print()
    for e in eps:
        kind, desc = describe_episode(e)
        print("%s %s  %s：%s" % (color("!", "33"), fmt_span(e["start"], e["end"]), kind, desc))
    for t, a, b in sws:
        print("· %s  内核切换：%s → %s" % (fmt_clock(t), a, b))
    return 0


def check_basic(ck, chain_cache=False):
    state = service_state()
    if state == "active":
        ck.add("OK", "dae 服务正在运行（active）。")
    else:
        ck.add("FAIL", "dae 服务未运行（状态：%s）！代理名单里的程序此刻会直接连接外网（故障即放行）。"
                       "请执行：sudo systemctl start dae" % state)
    listening = socks_listening()
    who = []
    if listening:
        who = listener_procs() or []
        desc = ", ".join("%s(pid %s)" % w for w in who) if who else listener_process()
        ck.add("OK", "SOCKS5 %s 正在监听%s。" % (socks_str(), ("，监听进程：" + desc) if desc else ""))
    else:
        ck.add("FAIL", "SOCKS5 %s 没有在监听！名单中的程序将无法联网（故障即断开）。请检查 v2rayN / xray。"
               % socks_str())
    procs = running_processes()
    cores = ["%s(pid %s)" % (n, ",".join(str(p) for p in sorted(procs[n]))) for n in CORE_NAMES if n in procs]
    if cores:
        ck.add("OK", "代理核心进程：%s" % "、".join(cores))
    elif listening:
        ck.add("WARN", "没有找到 xray / sing-box / mihomo 进程，但 %s 有程序在监听；"
                       "请确认监听者是代理核心且已在安全区块中直连。" % socks_str())
    else:
        ck.add("FAIL", "没有找到 xray / sing-box / mihomo 进程（代理核心未运行）。")
    if state == "active" and listening:
        # 记录是哪个内核在提供 SOCKS：监听进程最准确，看不到时退回正在运行的代理核心
        names = sorted({n for n, _ in who}) or [n for n in CORE_NAMES if n in procs]
        check_chain(ck, chain_cache, "+".join(names) or None)
    else:
        # dae 或端口已经报了 FAIL，链路探测没有意义；清掉旧状态，恢复后重新计数
        try:
            os.unlink(chain_state_path())
        except OSError:
            pass


def check_config(ck):
    target = config_path()
    try:
        st = os.stat(target)
    except OSError as e:
        ck.add("FAIL", "无法访问配置文件 %s：%s" % (target, e.strerror))
        return
    mode = st.st_mode & 0o7777
    if st.st_uid == 0 and mode & 0o037 == 0 and mode & 0o600 == 0o600:
        ck.add("OK", "配置文件权限正确：root 所有，%04o。" % mode)
    else:
        ck.add("FAIL", "配置文件权限不符合 dae 要求：属主 uid=%d，权限 %04o（应为 root 所有、0600 或 0640，"
                       "否则 dae 拒绝加载）。" % (st.st_uid, mode))
    try:
        text, _ = read_config_text()
    except PermissionError:
        ck.add("SKIP", "当前不是 root，无法读取配置：跳过 validate、安全区块、名单、dial_mode 检查。"
                       "以 sudo 运行可获得完整检查（sudo proxyctl check）。")
        view, _ = load_rules_view()
        if view:
            bad = [n for n in view.get("proxy", []) if is_blacklisted(n)]
            for n in bad:
                ck.add("WARN", "（来自缓存）代理名单包含通用运行时名称“%s”，建议执行 proxyctl remove %s。" % (n, n))
        return
    except (OSError, ProxyctlError) as e:
        ck.add("FAIL", "无法读取配置：%s" % e)
        return
    ck.add("OK", "配置文件可读取。")
    rc, out = dae_validate(target)
    if rc == 0:
        ck.add("OK", "配置通过 dae validate。")
    else:
        ck.add("FAIL", "配置未通过 dae validate：%s" % out.strip())
    try:
        parsed = Parsed(text)
    except ProxyctlError as e:
        ck.add("FAIL", "配置结构解析失败：%s" % e)
        return
    if not parsed.initialized:
        ck.add("FAIL", "配置中没有 proxyctl 管理区块，安全区块缺失。请执行 sudo proxyctl init。")
    elif parsed.safety_complete():
        ck.add("OK", "安全区块完整。")
    else:
        ck.add("FAIL", "安全区块不完整或顺序被改动。请执行 sudo proxyctl init 修复。")
    socks_nodes = config_socks_addrs(text)
    if socks_nodes and socks_str() not in socks_nodes:
        ck.add("WARN", "dae 配置中的 SOCKS5 节点是 %s，而 proxyctl 检查的是 %s。"
                       "请在 %s 中设置 socks = 实际地址，否则 check / test 的结果不准。"
               % ("、".join(sorted(socks_nodes)), socks_str(), conf_path()))
    before = parsed.rules_before_safety()
    if before:
        ck.add("WARN", "routing 中有 %d 条规则排在安全区块之前（首条命中生效，可能覆盖安全规则）：%s"
               % (len(before), "；".join(before)))
    if os.geteuid() == 0:
        write_cache(rules_view_from_parsed(parsed))
    bad = [n for n in parsed.names("proxy") if is_blacklisted(n)]
    if bad:
        for n in bad:
            ck.add("WARN", "代理名单包含通用运行时名称“%s”：会把所有同名程序一起代理。建议执行 proxyctl remove %s，"
                           "改用应用自身的代理设置。" % (n, n))
    elif parsed.initialized:
        ck.add("OK", "代理名单中没有通用运行时名称。")
    for n in parsed.names("proxy") + parsed.names("direct"):
        w = long_name_warning(n)
        if w:
            ck.add("WARN", w)
    dial = parsed.global_value("dial_mode")
    ck.add("INFO", "dial_mode：%s（仅展示）" % (dial if dial else "未设置（默认 domain）"))
    ck.add("INFO", "DNS 防泄漏：%s（详情：proxyctl dns）" % ("已开启" if parsed.dns_protected else "未开启"))
    resolve = [o for n, o in parsed.unmanaged_pname_rules() + parsed.entries["direct"] + parsed.entries["safety"]
               if n.startswith("systemd-resolve")]
    ck.add("INFO", "systemd-resolve 的 must_direct 规则：%s（仅展示）"
           % ("存在" if "must_direct" in resolve else "不存在"))


def check_extra(ck):
    pol = service_restart_policy()
    if pol is None:
        ck.add("WARN", "无法读取 dae 服务的 Restart 策略。")
    elif pol == "on-failure":
        ck.add("OK", "dae 服务 Restart=%s。" % pol)
    else:
        ck.add("WARN", "dae 服务 Restart=%s，建议为 on-failure（install.sh 会添加 systemd drop-in）。" % pol)
    ifaces = extra_ifaces() | default_route_ifaces()
    v6 = global_ipv6(ifaces)
    if v6:
        ck.add("WARN", "接口 %s 有全局 IPv6 地址（%s）。请单独测试 IPv6 下代理是否生效，"
                       "例如：%s -6 -sS --max-time 10 %s"
               % ("、".join(sorted({i for i, _ in v6})), "、".join(a for _, a in v6[:2]),
                  os.path.join(lib_dir(), "proxyctl-probe"), test_url()))
    elif ifaces:
        ck.add("OK", "%s 没有全局 IPv6 地址。" % "、".join(sorted(ifaces)))
    else:
        ck.add("OK", "没有找到默认路由接口，跳过 IPv6 检查。")


def _notify_state_path():
    base = os.environ.get("XDG_RUNTIME_DIR") or os.path.join(os.path.expanduser("~"), ".cache")
    return os.path.join(base, "proxyctl-notify.json")


def maybe_notify(fails):
    """有 FAIL 时弹通知；同一组故障 10 分钟内只提醒一次，避免定时器反复刷屏。
    曾经提醒过故障、现在恢复正常时，再发一条“已恢复”通知。"""
    path = _notify_state_path()
    sig = "\n".join(fails)
    now = time.time()
    try:
        with open(path) as f:
            last = json.load(f)
    except (OSError, ValueError):
        last = {}
    if not fails:
        if last:
            notify("proxyctl：代理已恢复正常",
                   "dae、SOCKS5 %s 与代理链路均已恢复，代理名单中的程序重新走代理。"
                   "故障期间如有程序直连，可执行 proxyctl test 复查。" % socks_str(), urgency="normal")
            try:
                os.unlink(path)
            except OSError:
                pass
        return
    if last.get("sig") == sig and now - last.get("time", 0) < 600:
        return
    notify("proxyctl：代理故障", "\n".join(fails)[:500])
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w") as f:
            json.dump({"sig": sig, "time": now}, f)
    except OSError:
        pass


def maybe_notify_slow(message):
    """链路很慢时弹一条普通级别的通知，30 分钟内只提醒一次；速度恢复后清除状态。"""
    base = os.environ.get("XDG_RUNTIME_DIR") or os.path.join(os.path.expanduser("~"), ".cache")
    path = os.path.join(base, "proxyctl-slow.json")
    if not message:
        try:
            os.unlink(path)
        except OSError:
            pass
        return
    try:
        with open(path) as f:
            last = json.load(f)
    except (OSError, ValueError):
        last = {}
    if time.time() - last.get("time", 0) < 1800:
        return
    notify("proxyctl：代理很慢", message, urgency="normal")
    try:
        os.makedirs(base, exist_ok=True)
        with open(path, "w") as f:
            json.dump({"time": time.time()}, f)
    except OSError:
        pass


def cmd_check(args):
    ck = Checker(args.quiet)
    check_basic(ck, chain_cache=args.basic)
    if not args.basic:
        check_config(ck)
        check_extra(ck)
    if args.notify:
        maybe_notify(ck.fails())
        maybe_notify_slow(None if ck.fails() else ck.slow)
    if not args.quiet:
        n = {l: sum(1 for x, _ in ck.results if x == l) for l in ("OK", "WARN", "FAIL")}
        print("汇总：OK %d，WARN %d，FAIL %d" % (n["OK"], n["WARN"], n["FAIL"]))
    return ck.exit_code()


# -- test --------------------------------------------------------------------


def _clean_env():
    env = {k: v for k, v in os.environ.items() if not k.lower().endswith("_proxy")}
    return env


def test_retries():
    try:
        return max(1, int(_env("PROXYCTL_TEST_RETRIES", "3")))
    except ValueError:
        return 3


def _curl_once(argv):
    # 注意：--noproxy '*' 会让 curl 连 -x 指定的代理也一起忽略，所以只在不带 -x 时使用。
    extra = [] if "-x" in argv else ["--noproxy", "*"]
    rc, out = run_cmd(argv + ["-sS", "--max-time", "10"] + extra + [test_url()],
                      timeout=20, env=_clean_env())
    text = out.strip()
    if rc != 0:
        return None, "curl 退出码 %d：%s" % (rc, text[:200])
    try:
        return str(ipaddress.ip_address(text)), None
    except ValueError:
        return None, "返回内容不是 IP 地址：%s" % text[:200]


def _curl_ip(argv):
    """最多尝试 test_retries() 次，避免节点偶发抖动造成误报。
    返回 (ip 或 None, 错误说明, 附加说明列表)。"""
    errors = []
    for attempt in range(1, test_retries() + 1):
        ip, err = _curl_once(argv)
        if ip:
            notes = []
            if errors:
                notes.append("第 %d 次尝试才成功（之前：%s）。偶发失败通常是节点或 xray 抖动。"
                             % (attempt, "；".join(errors)))
            return ip, None, notes
        errors.append(err)
    return None, "%s（共尝试 %d 次）" % (errors[-1], len(errors)), []


def speed_samples():
    try:
        return max(1, int(_env("PROXYCTL_SPEED_SAMPLES", "5")))
    except ValueError:
        return 5


def connect_slow_seconds():
    """新建一条代理连接的中位耗时超过这个秒数，test 给出“新连接慢”警告。"""
    try:
        return max(0.0, float(_env("PROXYCTL_CONNECT_SLOW", "1.5")))
    except ValueError:
        return 1.5


def measure_new_connections():
    """连续新开 speed_samples() 条经 SOCKS5 的连接（每次一个独立 curl，不复用），返回
    (成功耗时列表, 失败次数)。v2rayN 的延迟测试反映的是已建好连接上的一次请求，
    节点“新建连接很慢”时它仍显示几百毫秒，而 Claude 这类频繁新开连接的应用会反复超时重试。"""
    times, failures = [], 0
    for _ in range(speed_samples()):
        t0 = time.monotonic()
        rc, _out = run_cmd([curl_bin(), "-x", "socks5h://%s" % socks_str(), "-sS", "-o", "/dev/null",
                            "--max-time", "15", probe_url()], timeout=25, env=_clean_env())
        if rc == 0:
            times.append(time.monotonic() - t0)
        else:
            failures += 1
    return times, failures


def sysfs_net():
    return _env("PROXYCTL_SYSFS_NET", "/sys/class/net")


def tun_interfaces():
    """本机现有的 TUN 网卡（有 tun_flags 的接口），例如 v2rayN TUN 模式的 singbox_tun。"""
    try:
        names = sorted(os.listdir(sysfs_net()))
    except OSError:
        return []
    return [n for n in names if os.path.exists(os.path.join(sysfs_net(), n, "tun_flags"))]


def cmd_test(args):
    results = []
    warnings = []

    def report(ok, title, detail):
        results.append(ok)
        tag = color("[PASS]", "32") if ok else color("[FAIL]", "1;31")
        print("%s %s" % (tag, title))
        for line in detail:
            print("       %s" % line)

    def warn(title, detail):
        warnings.append(title)
        print("%s %s" % (color("[WARN]", "33"), title))
        for line in detail:
            print("       %s" % line)

    state = service_state()
    print("dae 服务状态：%s；SOCKS5 %s：%s" % (state, socks_str(), "监听中" if socks_listening() else "未监听"))

    url = test_url()
    proxy_ip, err, notes = _curl_ip([curl_bin(), "-x", "socks5h://%s" % socks_str()])
    if proxy_ip:
        report(True, "1. 通过 SOCKS5 直接访问 %s，得到代理出口 IP：%s" % (url, proxy_ip),
               ["说明代理客户端（v2rayN 等）与远程节点工作正常。"] + notes)
    else:
        report(False, "1. 通过 SOCKS5 %s 访问 %s 失败" % (socks_str(), url),
               [err, "说明 xray 未运行、节点不可用或 SOCKS 端口不对。此时名单中的程序无法联网（故障即断开）。"])

    probe = os.path.join(lib_dir(), "proxyctl-probe")
    direct = os.path.join(lib_dir(), "proxyctl-direct")

    if not os.access(probe, os.X_OK):
        report(False, "2. 找不到 %s" % probe, ["请先执行 sudo ./install.sh。"])
        probe_ip = None
    else:
        probe_ip, err, notes = _curl_ip([probe])
        if probe_ip is None:
            report(False, "2. proxyctl-probe（不设代理，依靠 dae 按进程名分流）访问失败",
                   [err, "dae 已把它送进代理，但代理链路不通；或 dae 工作异常。"])
        elif proxy_ip is None:
            report(False, "2. proxyctl-probe 得到 %s，但第 1 步失败，无法比较" % probe_ip, [])
        elif probe_ip == proxy_ip:
            report(True, "2. proxyctl-probe 得到 %s，与代理出口一致" % probe_ip,
                   ["说明 dae 按进程名把名单程序送进了代理。"] + notes)
        else:
            report(False, "2. proxyctl-probe 得到 %s，与代理出口 %s 不一致" % (probe_ip, proxy_ip),
                   ["说明 dae 没有拦截该进程：dae 未运行、配置未生效或安全区块缺失。",
                    "此时名单中的程序正在直连外网（故障即放行）。请执行 sudo proxyctl check。",
                    "（若节点有多个出口 IP 也可能出现此情况，可重试一次。）"])

    if not os.access(direct, os.X_OK):
        report(False, "3. 找不到 %s" % direct, ["请先执行 sudo ./install.sh。"])
    else:
        direct_ip, err, notes = _curl_ip([direct])
        if direct_ip is None:
            report(False, "3. proxyctl-direct（不在任何规则中）访问失败",
                   [err, "默认直连不通：请检查本机网络，或 %s 在本地直连下是否可达。" % url])
        elif proxy_ip is not None and direct_ip == proxy_ip:
            report(False, "3. proxyctl-direct 得到 %s，竟与代理出口相同" % direct_ip,
                   ["默认流量也走了代理：可能开启了系统代理/TUN，或 routing 的 fallback 不是 direct。"])
        else:
            report(True, "3. proxyctl-direct 得到 %s，与代理出口不同（默认直连正常）" % direct_ip, notes)

    if proxy_ip is not None:
        times, failures = measure_new_connections()
        limit = connect_slow_seconds()
        shown = "、".join("%.1f" % t for t in times) or "无"
        if not times:
            warn("4. 新建代理连接：%d 次全部失败" % failures,
                 ["第 1 步刚成功过，说明节点时通时断。建议在 v2rayN 中更换节点。"])
        else:
            median = sorted(times)[len(times) // 2]
            summary = "连续新开 %d 条连接，耗时（秒）：%s%s" % (
                len(times) + failures, shown, "，另有 %d 次失败" % failures if failures else "")
            if median > limit or failures:
                warn("4. 新建代理连接偏慢：中位 %.1f 秒（正常应在 %g 秒以内）" % (median, limit),
                     [summary,
                      "v2rayN 的延迟测试只反映已建好连接上的一次请求，这种情况下仍可能显示几百毫秒；",
                      "但 Claude 等频繁新开连接的应用会反复超时重试（Request failed · Retrying）。",
                      "建议：在 v2rayN 中双击当前节点开启“Mux 多路复用”后重启服务，或更换节点。"])
            else:
                report(True, "4. 新建代理连接速度正常：中位 %.1f 秒" % median, [summary])

    tuns = tun_interfaces()
    if tuns:
        warn("5. 检测到 TUN 网卡：%s" % "、".join(tuns),
             ["v2rayN 等的 TUN 模式会把整机流量送进代理，与 dae 叠加后绕过按程序分流的名单，",
              "也会让所有系统流量挤在同一条节点线路上。使用 proxyctl 时建议关闭 TUN 模式。"])

    ok = all(results)
    if not ok:
        print("结论：存在失败项，请参考上面的说明。")
    elif warnings:
        print("结论：分流工作正常，但有 %d 项警告，请参考上面的说明。" % len(warnings))
    else:
        print("结论：全部通过。")
    return 0 if ok else 1


# -- run / guard-desktop -------------------------------------------------------


def proxy_ready():
    state = service_state()
    if state != "active":
        return False, "dae 未运行（状态：%s）" % state
    if not socks_listening():
        return False, "SOCKS5 %s 未在监听（xray/v2rayN 未运行？）" % socks_str()
    return True, None


def cmd_run(args):
    cmd = list(args.command)
    if cmd and cmd[0] == "--":
        cmd = cmd[1:]
    if not cmd:
        raise ProxyctlError("用法：proxyctl run [--wait N] -- <命令...>")
    deadline = time.monotonic() + max(0, args.wait)
    while True:
        ok, reason = proxy_ready()
        if ok:
            break
        if time.monotonic() >= deadline:
            msg = "代理不可用，已阻止启动 %s：%s。" % (os.path.basename(cmd[0]), reason)
            print("错误：" + msg, file=sys.stderr)
            notify("proxyctl：已阻止启动", msg)
            return 1
        time.sleep(1)
    try:
        os.execvp(cmd[0], cmd)
    except OSError as e:
        raise ProxyctlError("无法启动 %s：%s" % (cmd[0], e))


GUARD_KEY = "X-Proxyctl-Guarded=true"


def user_apps_dir():
    base = os.environ.get("XDG_DATA_HOME") or os.path.join(os.path.expanduser("~"), ".local", "share")
    return _env("PROXYCTL_APPS_DIR", os.path.join(base, "applications"))


def system_apps_dirs():
    if os.environ.get("PROXYCTL_DESKTOP_DIRS"):
        return os.environ["PROXYCTL_DESKTOP_DIRS"].split(":")
    dirs = [os.path.join(d, "applications")
            for d in (os.environ.get("XDG_DATA_DIRS") or "/usr/local/share:/usr/share").split(":") if d]
    dirs += [os.path.expanduser("~/.local/share/flatpak/exports/share/applications"),
             "/var/lib/flatpak/exports/share/applications", "/var/lib/snapd/desktop/applications"]
    return dirs


def guard_exec_prefix():
    return "%s run --wait 30 --" % self_bin()


def guard_text(text):
    prefix = guard_exec_prefix()
    out = []
    changed = 0
    for line in text.splitlines(True):
        m = re.match(r"^(Exec\s*=\s*)(.*?)(\r?\n?)$", line)
        if m and not m.group(2).startswith(prefix):
            line = "Exec=%s %s%s" % (prefix, m.group(2), m.group(3))
            changed += 1
        out.append(line)
        if line.strip() == "[Desktop Entry]":
            out.append(GUARD_KEY + ("\r\n" if line.endswith("\r\n") else "\n"))
    return "".join(out), changed


def _atomic_write_text(path, text, mode=0o644):
    d = os.path.dirname(path)
    os.makedirs(d, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=d, prefix=".proxyctl-")
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(text)
    os.chmod(tmp, mode)
    os.replace(tmp, path)


def cmd_guard_desktop(args):
    name = os.path.basename(args.desktop)
    if not name.endswith(".desktop"):
        name += ".desktop"
    if name != os.path.basename(args.desktop.rstrip("/")) and "/" in args.desktop:
        pass  # 允许传入完整路径，但只使用文件名
    if not re.fullmatch(r"[A-Za-z0-9._@+-]+\.desktop", name):
        raise ProxyctlError("desktop 文件名不合法：%s" % name)
    target = os.path.join(user_apps_dir(), name)
    orig = target + ".proxyctl-orig"

    def is_ours(path):
        try:
            with open(path, encoding="utf-8") as f:
                return any(l.strip() == GUARD_KEY for l in f)
        except OSError:
            return False

    if args.undo:
        if not os.path.exists(target):
            print("没有找到 %s，无需撤销。" % target)
            return 0
        if not is_ours(target):
            raise ProxyctlError("%s 不是由 proxyctl 生成的，未做改动。" % target)
        if os.path.exists(orig):
            os.replace(orig, target)
            print("已恢复你原来的 %s。" % target)
        else:
            os.unlink(target)
            print("已删除覆盖副本 %s，恢复使用系统自带的启动器。" % target)
        return 0

    if os.path.exists(target) and not is_ours(target):
        src = target
        shutil.copy2(target, orig)
        print("你已有自定义的 %s，已另存为 %s，撤销时会恢复它。" % (target, orig))
    elif os.path.exists(target) and os.path.exists(orig):
        src = orig
    else:
        src = None
        for d in system_apps_dirs():
            p = os.path.join(d, name)
            if os.path.isfile(p):
                src = p
                break
        if src is None:
            raise ProxyctlError("在这些目录中找不到 %s：%s" % (name, "、".join(system_apps_dirs())))
    with open(src, encoding="utf-8") as f:
        text = f.read()
    if src == target:
        new, changed = guard_text(text)
    else:
        new, changed = guard_text("".join(l for l in text.splitlines(True) if l.strip() != GUARD_KEY))
    if changed == 0 and not any(re.match(r"^Exec\s*=", l) for l in text.splitlines()):
        raise ProxyctlError("%s 中没有 Exec= 行，无法加守卫。" % src)
    if re.search(r"^DBusActivatable\s*=\s*true", text, re.M | re.I):
        print("警告：该应用声明了 DBusActivatable=true，桌面环境可能通过 D-Bus 直接启动它而绕过 Exec= 守卫。")
    _atomic_write_text(target, new)
    print("已生成 %s（来源：%s），启动时会先确认 dae 与 %s 可用（最多等待 30 秒）。" % (target, src, socks_str()))
    print("撤销：proxyctl guard-desktop %s --undo" % name)
    return 0


# -- backups / restore ---------------------------------------------------------


def cmd_backups(args):
    names = list_backups()
    if not names:
        print("暂无备份（%s）。" % backup_dir())
        return 0
    print("备份目录：%s（保留最近 %d 份）" % (backup_dir(), BACKUP_KEEP))
    rows = []
    for n in reversed(names):
        st = os.stat(os.path.join(backup_dir(), n))
        rows.append([n, datetime.datetime.fromtimestamp(st.st_mtime).strftime("%Y-%m-%d %H:%M:%S"),
                     "%d 字节" % st.st_size])
    print(table(["备份名", "时间", "大小"], rows))
    print("恢复：sudo proxyctl restore <备份名>")
    return 0


def cmd_restore(args):
    name = os.path.basename(args.backup)
    if not BACKUP_RE.match(name):
        raise ProxyctlError("备份名不合法：%s（用 proxyctl backups 查看）" % args.backup)
    path = os.path.join(backup_dir(), name)
    try:
        with open(path, "rb") as f:
            data = f.read()
    except OSError as e:
        raise ProxyctlError("无法读取备份 %s：%s" % (path, e.strerror))
    try:
        text = data.decode("utf-8")
    except UnicodeDecodeError:
        raise ProxyctlError("备份文件不是 UTF-8 编码。")

    def compute(old):
        return text, ["将恢复备份：%s" % name]
    return transact("restore", compute)


def cmd_dns(args):
    if args.protect:
        return transact("dns-protect-" + args.protect, lambda t: op_dns_protect(t, args.protect == "on"))
    view, note = load_rules_view()
    if note:
        print(note)
    if view is not None and "dns" not in view:
        print("（规则缓存由旧版本生成，缺少 dae 的 DNS 设置，下面按 dae 默认值推断；执行一次 sudo proxyctl rules 即可更新。）")
    if args.name:
        validate_name(args.name)
        names = [args.name]
    else:
        names = list((view or {}).get("proxy", []))
        if not names:
            print("代理名单为空。可以指定进程名查看：proxyctl dns <进程名>")
            return 0
    resolver = resolver_info()
    dns = (view or {}).get("dns") or {}
    print("系统 DNS：/etc/resolv.conf → %s" % ("、".join(resolver["nameservers"]) or "（读不到）"))
    if resolver["kind"] == "resolved":
        print("systemd-resolved 上游：%s%s" % ("、".join(resolver["upstreams"]) or "（读不到）",
                                           "（DoT 加密）" if resolver.get("dot") else ""))
    print("DNS 防泄漏：%s" % ("已开启（国外域名经代理查询）" if dns.get("protect") else
                            "未开启（开启：sudo proxyctl dns --protect on）"))
    print("dae：dial_mode = %s；dns 区块：%s" % (
        dns.get("dial_mode", "domain"),
        ("上游 %s，默认 %s" % ("、".join(dns.get("upstreams", {})) or "无", dns.get("request_fallback") or "asis"))
        if dns.get("has_dns") else "未配置（asis：转发给原目标服务器）"))
    for members, r in dns_groups(names, view, resolver, raw_connections()):
        print()
        print(color("【%s】" % "、".join(members), "1"))
        for i, (title, desc, level) in enumerate(r["steps"], 1):
            mark = {"ok": color("✓", "32"), "warn": color("!", "33")}.get(level, "·")
            print("  %s %d. %s：%s" % (mark, i, title, desc))
        for line in dns_summary(r)[:2]:
            print("  → %s" % line)
    print()
    print("提示：%s" % dns_summary({"facts": {}})[-1])
    return 0


def cmd_export(args):
    view, note = load_rules_view()
    if view is None:
        raise ProxyctlError(note)
    if not view.get("initialized"):
        raise ProxyctlError("配置尚未初始化（找不到 proxyctl 管理区块），没有可导出的名单。")
    if note:
        print(note, file=sys.stderr)
    text = export_text(view)
    if args.file in (None, "-"):
        sys.stdout.write(text)
        return 0
    path = os.path.abspath(args.file)
    try:
        _atomic_write_text(path, text)
    except OSError as e:
        raise ProxyctlError("无法写入 %s：%s" % (path, e.strerror or e))
    if os.geteuid() == 0 and os.environ.get("SUDO_UID", "").isdigit():
        try:  # sudo proxyctl export：文件归调用者所有，而不是 root
            os.chown(path, int(os.environ["SUDO_UID"]), int(os.environ.get("SUDO_GID", "-1") or -1))
        except (OSError, ValueError):
            pass
    print("已导出到 %s：代理名单 %d 个，直连保护 %d 个。" % (path, len(view.get("proxy", [])), len(view.get("direct", []))))
    print("文件只含进程名，不含节点或订阅信息。导入：sudo proxyctl import %s" % args.file)
    return 0


def read_import_file(path):
    try:
        with open(path, "rb") as f:
            raw = f.read(IMPORT_MAX_BYTES + 1)
    except OSError as e:
        raise ProxyctlError("无法读取导入文件 %s：%s" % (path, e.strerror or e))
    return parse_import(raw)


def cmd_import(args):
    data = read_import_file(args.file)
    print("导入 %s（%s）：文件中有代理名单 %d 个，直连保护 %d 个。"
          % (args.file, "替换现有规则" if args.replace else "合并到现有规则", len(data["proxy"]), len(data["direct"])))
    return transact("import", lambda t: op_import(t, data, args.replace))


