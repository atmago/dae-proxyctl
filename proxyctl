                _atomic_write_text(path, export_text(view))
            except OSError as e:
                self.dialog("导出失败", "无法写入 %s：%s" % (path, e.strerror or e), error=True)
                return
            self.toast("已导出：代理 %d 个，直连保护 %d 个" % (len(view.get("proxy", [])), len(view.get("direct", []))),
                       detail="已保存到 %s\n文件只含进程名，不含节点或订阅信息。" % path, title="导出规则")
        self.pick_file(True, "导出规则", write,
                       name="proxyctl-%s.json" % datetime.date.today().strftime("%Y%m%d"))

    def on_import(self):
        if self.busy:
            return
        self.pick_file(False, "导入规则", self.confirm_import)

    def confirm_import(self, path):
        try:
            data = read_import_file(path)
        except ProxyctlError as e:
            self.dialog("无法导入", str(e), error=True)
            return
        view = self.view or {}
        cur_p, cur_d = view.get("proxy", []), view.get("direct", [])
        lines = ["文件：%s" % path,
                 "文件中有代理名单 %d 个，直连保护 %d 个。" % (len(data["proxy"]), len(data["direct"])), ""]
        actions = []
        for label, replace, main in (("合并", False, True), ("替换", True, False)):
            p, d, msgs = import_plan(cur_p, cur_d, data, replace)
            lines.append("【%s】%s" % (label, "只新增，保留现有规则" if not replace else "现有规则改为与文件完全一致"))
            lines.extend("  " + m for m in (msgs or ["名单无变化"]))
            lines.append("")
            if (p, d) != (cur_p, cur_d):
                actions.append((label, lambda r=replace: self.priv(["import", path] + (["--replace"] if r else [])), main))
        if not actions:
            self.dialog("导入规则", "\n".join(lines + ["规则已与文件一致，无需导入。"]))
            return
        if len(actions) == 1:
            actions[0] = actions[0][:2] + (True,)
        lines.append("导入后 dae 会重新加载，正在走代理的程序会短暂断线并自动重连。")
        self.dialog("导入规则", "\n".join(lines).rstrip(), warn=True, actions=actions)

    def on_test(self):
        self.btn_test.set_sensitive(False)
        self.set_status("正在自检（约 10 秒）", busy=True)
        me = os.path.realpath(__file__)

        def work():
            rc, out = run_cmd([sys.executable, me, "test"], timeout=120, env=dict(os.environ, NO_COLOR="1"))
            self.GLib.idle_add(self.test_done, rc, out)
        threading.Thread(target=work, daemon=True).start()

    def test_done(self, rc, out):
        self.btn_test.set_sensitive(True)
        self.set_status("")
        warn = rc == 0 and "WARN" in out
        self.dialog("自检全部通过" if rc == 0 and not warn else ("自检通过，但有警告" if rc == 0 else "自检未通过"),
                    out.strip(), error=rc != 0, warn=warn)
        return False

    def dialog(self, title, text, error=False, warn=False, actions=()):
        """显示命令输出：顶部一行结论，下面是可复制的原始输出。

        actions：额外按钮 [(文字, 回调, 是否主按钮), ...]，点击后关闭对话框再执行回调。
        """
        Gtk = self.Gtk
        d = Gtk.Window()
        d.set_title(title)
        d.set_transient_for(self.win)
        d.set_modal(True)
        d.set_default_size(680, 440)
        box = self.margins(self.box(vertical=True, spacing=12), 18)
        head = self.box(spacing=10)
        level = "bad" if error else ("warn" if warn else "ok")
        icon = {"bad": "dialog-error-symbolic", "warn": "dialog-warning-symbolic"}.get(level, "emblem-ok-symbolic")
        wrap = self.css(self.box(), "hero-" + level)  # 只借用图标颜色
        self.put(wrap, self.css(self.image(icon, 24), "hero-icon"))
        self.put(head, wrap)
        self.put(head, self.label(title, classes=("hero-title",)))
        self.put(box, head)
        view = Gtk.TextView()
        view.set_editable(False)
        view.set_cursor_visible(False)
        view.set_monospace(True)
        view.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
        self.margins(view, 10)
        self.css(view, "output")
        view.get_buffer().set_text(text)
        sw = self.put(box, self.scrolled(view))
        self.css(sw, "card" if self.Adw else "card-list")
        btns = self.box(spacing=8)
        btns.set_halign(Gtk.Align.END)
        copy = self.put(btns, self.button("复制输出", self.copy_text, text))
        copy.connect("clicked", lambda _w: copy.set_label("已复制"))
        ok = self.put(btns, self.button("取消" if actions else "关闭", d.destroy))
        for text_, cb, main in actions:
            b = self.put(btns, self.button(text_, lambda cb=cb: (d.destroy(), cb())))
            if main:
                ok = self.css(b, "suggested-action")
        if not actions:
            self.css(ok, "suggested-action")
        self.put(box, btns)
        self.put(d, box)
        self.show(d)
        ok.grab_focus()

    def snapshot(self, path):
        """开发用：把窗口渲染成 PNG（仅 GTK4），用于检查排版。"""
        if self.ver != 4:
            return
        try:
            w, h = self.win.get_width(), self.win.get_height()
            paintable = self.Gtk.WidgetPaintable.new(self.win)
            snap = self.Gtk.Snapshot()
            paintable.snapshot(snap, w, h)
            node = snap.to_node()
            texture = self.win.get_native().get_renderer().render_texture(node, None)
            texture.save_to_png(path)
        except Exception as e:  # noqa
            print("截图失败：%r" % (e,), file=sys.stderr)

    def quit(self):
        if os.environ.get("PROXYCTL_GUI_SNAPSHOT"):
            self.snapshot(os.environ["PROXYCTL_GUI_SNAPSHOT"])
        if os.environ.get("PROXYCTL_GUI_DUMP"):
            print(json.dumps({"rows": self.dump, "banner": self.alert}, ensure_ascii=False))
            sys.stdout.flush()
        self.app.quit()
        return False

    def run(self):
        return self.app.run([sys.argv[0]])


