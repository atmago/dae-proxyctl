def run_cmd(argv, timeout=60, env=None):
    """执行外部命令，返回 (returncode, 合并后的输出)。找不到程序时返回 127。"""
    try:
        p = subprocess.run(argv, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                           stdin=subprocess.DEVNULL, timeout=timeout, env=env)
        return p.returncode, p.stdout.decode("utf-8", "replace")
    except FileNotFoundError:
        return 127, "找不到程序：%s" % argv[0]
    except subprocess.TimeoutExpired:
        return 124, "执行超时（%ss）：%s" % (timeout, " ".join(argv))
    except OSError as e:
        return 126, "无法执行 %s：%s" % (argv[0], e)


SOCKS_URL_RE = re.compile(r"socks5h?://(?:[^@'\"\s]*@)?([^'\"\s/#?]+)")


def config_socks_addrs(text):
    """dae 配置中出现的 socks5:// 节点地址（localhost 统一为 127.0.0.1）。"""
    addrs = set()
    for m in SOCKS_URL_RE.finditer(text):
        host, _, port = m.group(1).rpartition(":")
        if host.lower() == "localhost":
            host = "127.0.0.1"
        addrs.add("%s:%s" % (host, port))
    return addrs


def dae_validate(path):
    return run_cmd([dae_bin(), "validate", "-c", path], timeout=60)


def service_state():
    rc, out = run_cmd([systemctl_bin(), "is-active", service_name()], timeout=15)
    state = out.strip().splitlines()[-1].strip() if out.strip() else "unknown"
    if rc == 127:
        return "unknown"
    return state


def service_active():
    return service_state() == "active"


def service_reload():
    return run_cmd([systemctl_bin(), "reload", service_name()], timeout=60)


def service_restart_policy():
    rc, out = run_cmd([systemctl_bin(), "show", service_name(), "-p", "Restart", "--value"], timeout=15)
    return out.strip() if rc == 0 else None


def wait_still_active(settle):
    """reload 之后观察一段时间，确认服务仍为 active。"""
    deadline = time.monotonic() + max(settle, 0)
    state = service_state()
    while True:
        if state not in ("active", "reloading"):
            return False, state
        if time.monotonic() >= deadline:
            break
        time.sleep(0.25)
        state = service_state()
    # reloading 可能持续片刻，再多等一会
    for _ in range(20):
        if state != "reloading":
            break
        time.sleep(0.25)
        state = service_state()
    return state == "active", state


def socks_listening(timeout=1.0):
    host, port = socks_addr()
    try:
        with socket.create_connection((host, port), timeout=timeout):
            return True
    except OSError:
        return False


def gvariant_str(s):
    """把 Python 字符串写成 GVariant 文本格式的字符串字面量（gdbus call 的参数）。"""
    return "'%s'" % (s.replace("\\", "\\\\").replace("'", "\\'")
                     .replace("\n", "\\n").replace("\r", "\\r").replace("\t", "\\t"))


def notify(title, body, urgency="critical"):
    """弹出桌面通知。

    实测本机 GNOME 的通知转发进程（org.gnome.Shell.Notifications）会“接收却不显示”
    notify-send 的通知（返回成功，所以无法据此判断失败），而直接调用 GNOME Shell
    自身的 org.freedesktop.Notifications 接口可以正常弹出。因此优先直接调用 GNOME Shell；
    不是 GNOME 或调用失败时，再退回 notify-send。
    """
    level = {"low": 0, "normal": 1, "critical": 2}.get(urgency, 2)
    rc, _ = run_cmd([gdbus_bin(), "call", "--session", "--dest", "org.gnome.Shell",
                     "--object-path", "/org/freedesktop/Notifications",
                     "--method", "org.freedesktop.Notifications.Notify",
                     gvariant_str("proxyctl"), "uint32 0", gvariant_str(""),
                     gvariant_str(title), gvariant_str(body), "@as []",
                     "{'urgency': <byte %d>}" % level, "int32 -1"], timeout=10)
    if rc != 0:
        run_cmd([notify_bin(), "-u", urgency, "-a", "proxyctl", title, body], timeout=10)


