NAME_RE = re.compile(r"[A-Za-z0-9._+-]{1,64}")
COMM_MAX = 15  # 内核 TASK_COMM_LEN=16，进程名最多 15 个字符

BLACKLIST = frozenset("""
python python3 python3. node nodejs java electron bash sh zsh fish dash perl
ruby php dotnet mono wine wine64 wineserver systemd sudo ssh curl wget git
""".split())
BLACKLIST_RE = re.compile(r"python3\.[0-9]*")  # python3.12、python3.14 ……

SAFETY_RULES = (
    ("xray", "must_direct"),
    ("sing-box", "must_direct"),
    ("mihomo", "must_direct"),
    ("proxyctl-probe", "proxy"),
)
SAFETY_NAMES = {n: o for n, o in SAFETY_RULES}
CORE_NAMES = ("xray", "sing-box", "mihomo")

BLOCKS = ("safety", "direct", "proxy")
BLOCK_OUTBOUND = {"direct": "must_direct", "proxy": "proxy"}
BEGIN_MARK = {
    "safety": "# >>> proxyctl:safety (do not edit) >>>",
    "direct": "# >>> proxyctl:direct >>>",
    "proxy": "# >>> proxyctl:proxy >>>",
}
END_MARK = {b: "# <<< proxyctl:%s <" % b for b in BLOCKS}
# 可选的“DNS 防泄漏”区域：routing 中的一条 dip 规则 + 文件末尾的 dns 区块，二者同时存在或同时不存在
DNS_REGIONS = ("dns-route", "dns")
BEGIN_MARK.update({r: "# >>> proxyctl:%s >>>" % r for r in DNS_REGIONS})
END_MARK.update({r: "# <<< proxyctl:%s <" % r for r in DNS_REGIONS})
PROTECT_DNS_IP = "8.8.8.8"
PROTECT_DNS_UPSTREAM = "googledns"
PROTECT_DNS_BLOCK = """dns {
    upstream {
        %s: 'tcp+udp://%s:53'
    }
    routing {
        request {
            # 局域网、反向解析和国内域名照旧交给原来的 DNS（路由器），其余域名经代理查询
            qname(geosite:private, geosite:cn, suffix: lan) -> asis
            fallback: %s
        }
    }
}""" % (PROTECT_DNS_UPSTREAM, PROTECT_DNS_IP, PROTECT_DNS_UPSTREAM)
PROTECT_ROUTE_RULE = "dip(%s) -> proxy" % PROTECT_DNS_IP
MARKERISH_RE = re.compile(r"^#\s*(>>>|<<<)\s*proxyctl:")

RULE_RE = re.compile(r"^\s*pname\(\s*([^()\s,]+)\s*\)\s*->\s*([A-Za-z_][A-Za-z0-9_-]*)\s*$")
ROUTING_OPEN_RE = re.compile(r"^\s*routing\s*\{\s*$")
ROUTING_WORD_RE = re.compile(r"^\s*routing\b")

STATUS_PROXY = "代理"
STATUS_DIRECT = "直连保护"
STATUS_DEFAULT = "默认直连"
STATUS_UNKNOWN = "未知"
