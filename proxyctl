    def resolver(self):
        now = time.monotonic()
        if now - self.resolver_cache[0] > 30 or self.resolver_cache[1] is None:
            self.resolver_cache = (now, resolver_info())
        return self.resolver_cache[1]

    def refresh_procs(self, view):
        try:
            conns = ss_connections()
            rows = list_rows(view, conns)
        except ProxyctlError as e:
            self.set_status(str(e))
            conns, rows = [], []
        resolver = self.resolver() if view is not None else None
        rows = merge_recent(self.history, rows, time.monotonic(), gui_recent_seconds())
        data = []
        for r in rows:
            st = r["status"]
            gone = gone_text(r["gone"]) if "gone" in r else ""
            if gone:
                # 已消失的行：按当前规则重新计算状态（例如刚刚被加入代理）
                now_st = status_of(r["name"], view)
                st = st if (st == STATUS_CHILD and now_st == STATUS_DEFAULT) else now_st
            dns = None
            if resolver is not None and NAME_RE.fullmatch(r["name"]):
                dns = dns_badge(dns_route(r["name"], view, resolver, conns), route_of(r["name"], view)[0])
            data.append((r["name"], r["pids"], r["conns"], st, ", ".join(r["samples"]), gone, dns))
        self.view = view
        if data != self.proc_sig:
            self.proc_sig = data
            self.proc_data = data
            self.render_procs()

