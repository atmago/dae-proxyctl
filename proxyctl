def validate_name(name):
    if not isinstance(name, str) or not NAME_RE.fullmatch(name):
        raise ProxyctlError(
            "进程名 %r 不合法：只允许字母、数字和 . _ + -，长度 1–64。"
            "（这样可以防止向 dae 配置注入语法。）" % (name,))
    return name


def is_blacklisted(name):
    low = name.lower()
    return low in BLACKLIST or bool(BLACKLIST_RE.fullmatch(low))


def blacklist_reason(name):
    return (
        "“%s”是通用运行时/系统工具的进程名。dae 的 pname 只按进程名匹配，"
        "加入代理名单会把所有同名程序一起送进代理（例如 python3 会把量化交易等"
        "其他 Python 程序也代理掉）。请改用该应用自身的代理设置，"
        "例如 SOCKS5 %s 或环境变量 ALL_PROXY=socks5h://%s。" % (name, socks_str(), socks_str()))


def long_name_warning(name):
    if len(name) > COMM_MAX:
        return ("警告：进程名“%s”超过 %d 个字符。Linux 内核中的进程名会被截断为前 %d 个字符"
                "（%s），dae 看到的是截断后的名字，这条规则很可能不会命中。"
                % (name, COMM_MAX, COMM_MAX, name[:COMM_MAX]))
    return None


# ---------------------------------------------------------------------------
# 配置解析
# ---------------------------------------------------------------------------


def code_part(line, keep_strings=False):
    """去掉行尾换行和注释；默认还去掉引号内的内容，只留下用于结构分析的代码部分。"""
    line = line.rstrip("\r\n")
    out = []
    quote = None
    i = 0
    while i < len(line):
        c = line[i]
        if quote:
            if keep_strings:
                out.append(line[i:i + 2] if c == "\\" else c)
            if c == "\\":
                i += 2
                continue
            if c == quote:
                quote = None
            i += 1
            continue
        if c in "'\"":
            quote = c
            if keep_strings:
                out.append(c)
            i += 1
            continue
        if c == "#":
            break
        out.append(c)
        i += 1
    return "".join(out)


def is_comment_line(line):
    s = line.strip()
    return s.startswith("#") and not code_part(line).strip()


def is_blank(line):
    return not line.strip()


class Parsed(object):
    """config.dae 的结构化视图。lines 保留原始换行符，便于逐字节还原。"""

    def __init__(self, text):
        self.text = text
        self.lines = text.splitlines(True)
        self.nl = "\r\n" if "\r\n" in text else "\n"
        self.rs = None  # routing { 所在行
        self.re = None  # routing 结束 } 所在行
        self.blocks = None  # {block: (begin, end)} 或 None（未初始化）
        self.regions = {}  # DNS 防泄漏区域 {"dns-route"/"dns": (begin, end)}
        self.entries = {b: [] for b in BLOCKS}
        self.indent = "    "
        self._parse()

    # -- 结构 --------------------------------------------------------------
    def _parse(self):
        depth = 0
        routing = []
        for i, line in enumerate(self.lines):
            code = code_part(line)
            if depth == 0 and ROUTING_WORD_RE.match(code):
                if not ROUTING_OPEN_RE.match(code):
                    raise ProxyctlError(
                        "第 %d 行的 routing 块写法无法可靠解析（要求“routing {”单独占一行）。"
                        "为安全起见未做任何修改。" % (i + 1))
                routing.append(i)
            for c in code:
                if c == "{":
                    depth += 1
                elif c == "}":
                    depth -= 1
                    if depth < 0:
                        raise ProxyctlError("配置第 %d 行出现多余的“}”，结构无法可靠解析，未做任何修改。" % (i + 1))
            if routing and self.re is None and len(routing) == 1 and i > routing[0] and depth == 0:
                self.re = i
        if depth != 0:
            raise ProxyctlError("配置中的大括号不配对，结构无法可靠解析，未做任何修改。")
        if not routing:
            raise ProxyctlError("配置中找不到 routing 块，无法管理规则，未做任何修改。")
        if len(routing) > 1:
            raise ProxyctlError("配置中有多个 routing 块，无法可靠判断，未做任何修改。")
        self.rs = routing[0]
        if self.re is None or code_part(self.lines[self.re]).strip() != "}":
            raise ProxyctlError("routing 块的结束“}”必须单独占一行，结构无法可靠解析，未做任何修改。")
        for i in range(self.rs + 1, self.re):
            code = code_part(self.lines[i])
            if "{" in code or "}" in code:
                raise ProxyctlError("routing 块第 %d 行包含大括号，结构无法可靠解析，未做任何修改。" % (i + 1))
        self._parse_markers()

    def _parse_markers(self):
        found = {}
        for i, line in enumerate(self.lines):
            s = line.strip()
            if not MARKERISH_RE.match(s):
                continue
            key = None
            for b in BLOCKS + DNS_REGIONS:
                if s == BEGIN_MARK[b]:
                    key = (b, "begin")
                elif s == END_MARK[b]:
                    key = (b, "end")
            if key is None:
                raise ProxyctlError("第 %d 行的 proxyctl 标记无法识别：%s（标记已损坏）" % (i + 1, s))
            if key in found:
                raise ProxyctlError("proxyctl 标记重复出现（第 %d 行和第 %d 行），标记已损坏。"
                                    % (found[key] + 1, i + 1))
            inside = self.rs < i < self.re
            if inside != (key[0] != "dns"):
                raise ProxyctlError("第 %d 行的 proxyctl 标记位于%s，标记已损坏。"
                                    % (i + 1, "routing 块之内" if inside else "routing 块之外"))
            found[key] = i
        self._parse_regions(found)
        found = {k: v for k, v in found.items() if k[0] in BLOCKS}
        if not found and self.regions:
            raise ProxyctlError("配置中有 proxyctl 的 DNS 区域，却没有 proxyctl 管理区块，标记已损坏。")
        if not found:
            self.blocks = None
            body = [l for l in self.lines[self.rs + 1:self.re] if l.strip()]
            if body:
                self.indent = re.match(r"^[ \t]*", body[0]).group(0) or "    "
            return
        order = []
        for b in BLOCKS:
            for kind in ("begin", "end"):
                if (b, kind) not in found:
                    raise ProxyctlError(
                        "proxyctl 管理区块不完整（缺少 %s 区块的%s标记），标记已损坏。"
                        "请手工修复，或用 proxyctl restore 恢复备份。"
                        % (b, "开始" if kind == "begin" else "结束"))
                order.append(found[(b, kind)])
        if order != sorted(order):
            raise ProxyctlError("proxyctl 管理区块的顺序不正确（必须是 safety → direct → proxy），标记已损坏。")
        self.blocks = {b: (found[(b, "begin")], found[(b, "end")]) for b in BLOCKS}
        if self.regions and self.regions["dns-route"][0] < self.blocks["proxy"][1]:
            raise ProxyctlError("proxyctl 的 dns-route 区域必须位于代理名单区块之后，标记已损坏。")
        self.indent = re.match(r"^[ \t]*", self.lines[found[("safety", "begin")]]).group(0)
        for b in BLOCKS:
            begin, end = self.blocks[b]
            for i in range(begin + 1, end):
                line = self.lines[i]
                if is_blank(line):
                    continue
                m = RULE_RE.match(line.rstrip("\r\n"))
                if not m or not NAME_RE.fullmatch(m.group(1)):
                    raise ProxyctlError("管理区块 %s 的第 %d 行无法识别：%s（请不要手工编辑管理区块）"
                                        % (b, i + 1, line.strip()))
                name, outbound = m.group(1), m.group(2)
                if b in BLOCK_OUTBOUND and outbound != BLOCK_OUTBOUND[b]:
                    raise ProxyctlError("管理区块 %s 的第 %d 行出口应为 %s：%s"
                                        % (b, i + 1, BLOCK_OUTBOUND[b], line.strip()))
                if b == "safety" and outbound not in ("proxy", "must_direct"):
                    raise ProxyctlError("安全区块第 %d 行出口无法识别：%s" % (i + 1, line.strip()))
                self.entries[b].append((name, outbound))

    def _parse_regions(self, found):
        keys = [(r, k) for r in DNS_REGIONS for k in ("begin", "end")]
        have = [k for k in keys if k in found]
        if not have:
            return
        if len(have) != len(keys):
            raise ProxyctlError("proxyctl 的 DNS 防泄漏区域不完整，标记已损坏。请手工修复，或用 proxyctl restore 恢复备份。")
        for r in DNS_REGIONS:
            b, e = found[(r, "begin")], found[(r, "end")]
            if e < b:
                raise ProxyctlError("proxyctl 的 %s 区域标记顺序颠倒，标记已损坏。" % r)
            self.regions[r] = (b, e)
        if self.regions["dns"][0] < self.re:
            raise ProxyctlError("proxyctl 的 dns 区域必须位于 routing 块之后，标记已损坏。")

    # -- 查询 --------------------------------------------------------------
    @property
    def dns_protected(self):
        return bool(self.regions)

    @property
    def initialized(self):
        return self.blocks is not None

    def names(self, block):
        seen = []
        for n, _ in self.entries[block]:
            if n not in seen:
                seen.append(n)
        return seen

    def managed_index(self):
        idx = set()
        if self.blocks:
            for b in BLOCKS:
                begin, end = self.blocks[b]
                idx.update(range(begin, end + 1))
        for begin, end in self.regions.values():
            idx.update(range(begin, end + 1))
        return idx

    def unmanaged_rules(self):
        """routing 中不受 proxyctl 管理的规则行（去掉注释和空行）。"""
        managed = self.managed_index()
        out = []
        for i in range(self.rs + 1, self.re):
            if i in managed:
                continue
            code = code_part(self.lines[i], keep_strings=True).strip()
            if code:
                out.append((i, code))
        return out

    def unmanaged_pname_rules(self):
        out = []
        for i, code in self.unmanaged_rules():
            m = RULE_RE.match(code)
            if m:
                out.append((m.group(1), m.group(2)))
        return out

    def rules_before_safety(self):
        if not self.blocks:
            return []
        return [c for i, c in self.unmanaged_rules() if i < self.blocks["safety"][0]]

    def safety_complete(self):
        return self.initialized and list(self.entries["safety"][:len(SAFETY_RULES)]) == list(SAFETY_RULES)

    def global_value(self, key):
        """读取 global 块中某个键的值（仅做信息展示）。"""
        depth = 0
        in_global = False
        for line in self.lines:
            code = code_part(line)
            if depth == 0 and re.match(r"^\s*global\s*\{", code):
                in_global = True
            elif in_global and depth == 1:
                m = re.match(r"^\s*%s\s*:\s*(.+?)\s*$" % re.escape(key), code)
                if m:
                    return m.group(1).strip("'\"")
            depth += code.count("{") - code.count("}")
            if depth == 0:
                in_global = False
        return None


# ---------------------------------------------------------------------------
# 渲染
# ---------------------------------------------------------------------------


def _dedupe(entries):
    out = []
    for e in entries:
        if e not in out:
            out.append(e)
    return out


def safety_entries(existing, messages=None):
    """规范的安全区块：固定规则永远在最前面；用户额外加入的合法规则不删除。"""
    out = list(SAFETY_RULES)
    for name, outbound in existing:
        if name in SAFETY_NAMES:
            if outbound != SAFETY_NAMES[name] and messages is not None:
                messages.append("警告：安全区块中的 pname(%s) -> %s 与固定规则冲突且永远不会命中，已由固定规则取代。"
                                % (name, outbound))
            continue
        if (name, outbound) not in out:
            out.append((name, outbound))
    return out


def render_block(block, entries, indent, nl):
    lines = [indent + BEGIN_MARK[block] + nl]
    for name, outbound in _dedupe(entries):
        lines.append("%spname(%s) -> %s%s" % (indent, name, outbound, nl))
    lines.append(indent + END_MARK[block] + nl)
    return lines


def render(parsed, lists):
    """仅替换三个管理区块（含标记行），其余每一行原样保留。"""
    assert parsed.initialized
    lines = list(parsed.lines)
    for block in reversed(BLOCKS):
        begin, end = parsed.blocks[block]
        nl = parsed.nl
        if lines[end].endswith("\r\n"):
            nl = "\r\n"
        elif lines[end].endswith("\n"):
            nl = "\n"
        new = render_block(block, lists[block], parsed.indent, nl)
        if not lines[end].endswith(("\n", "\r")):
            new[-1] = new[-1].rstrip("\r\n")
        lines[begin:end + 1] = new
    return "".join(lines)


def current_lists(parsed, messages=None):
    return {
        "safety": safety_entries(parsed.entries["safety"], messages),
        "direct": [(n, "must_direct") for n in parsed.names("direct")],
        "proxy": [(n, "proxy") for n in parsed.names("proxy")],
    }


# ---------------------------------------------------------------------------
# 配置变换（纯函数：旧文本 -> (新文本, 消息列表)）
# ---------------------------------------------------------------------------


def op_init(text):
    parsed = Parsed(text)
    msgs = []
    if parsed.initialized:
        lists = current_lists(parsed, msgs)
        if parsed.entries["safety"] != lists["safety"]:
            msgs.append("安全区块不完整或有偏差，已修复。")
        else:
            msgs.append("管理区块已存在，安全区块完整。")
        for name in parsed.names("proxy"):
            if is_blacklisted(name):
                msgs.append("警告：代理名单中包含通用运行时名称“%s”，建议执行 proxyctl remove %s。" % (name, name))
        return render(parsed, lists), msgs

    lines = parsed.lines
    rs, re_ = parsed.rs, parsed.re
    removed = set()
    direct, proxy = [], []
    effective = {}  # name -> outbound（首条命中）
    for i in range(rs + 1, re_):
        code = code_part(lines[i], keep_strings=True).strip()
        if not code:
            continue
        m = RULE_RE.match(code)
        if not m or m.group(2) not in ("proxy", "must_direct"):
            continue
        name, outbound = m.group(1), m.group(2)
        if not NAME_RE.fullmatch(name):
            msgs.append("警告：第 %d 行的进程名“%s”不符合命名规则，保留原位，未迁移。" % (i + 1, name))
            continue
        if name in SAFETY_NAMES:
            if outbound != SAFETY_NAMES[name]:
                msgs.append("警告：第 %d 行 pname(%s) -> %s 与安全区块冲突，已被安全区块覆盖，保留原位未迁移。"
                            % (i + 1, name, outbound))
                continue
        elif name in effective:
            if effective[name] != outbound:
                msgs.append("警告：第 %d 行 pname(%s) -> %s 与前面的规则冲突（首条命中生效，本行从未生效），"
                            "保留原位未迁移。" % (i + 1, name, outbound))
                continue
        else:
            effective[name] = outbound
            (proxy if outbound == "proxy" else direct).append(name)
        removed.add(i)
        prev = i - 1
        if prev > rs and prev not in removed and is_comment_line(lines[prev]) \
                and not MARKERISH_RE.match(lines[prev].strip()) \
                and not (prev - 1 > rs and is_comment_line(lines[prev - 1])):
            removed.add(prev)

    body = []
    last_blank = False
    pending_removed = False
    for i in range(rs + 1, re_):
        if i in removed:
            pending_removed = True
            continue
        if is_blank(lines[i]) and last_blank and pending_removed:
            continue  # 删除规则后留下的连续空行合并为一行
        body.append(lines[i])
        last_blank = is_blank(lines[i])
        pending_removed = False

    indent = parsed.indent
    nl = parsed.nl
    managed = []
    lists = {"safety": list(SAFETY_RULES),
             "direct": [(n, "must_direct") for n in direct],
             "proxy": [(n, "proxy") for n in proxy]}
    for b in BLOCKS:
        managed.extend(render_block(b, lists[b], indent, nl))
    if body and not is_blank(body[0]):
        managed.append(nl)
    new_lines = lines[:rs + 1] + managed + body + lines[re_:]
    new_text = "".join(new_lines)

    msgs.append("已创建管理区块（safety / direct / proxy）。")
    for n in direct:
        msgs.append("已迁移到直连保护：%s" % n)
    for n in proxy:
        msgs.append("已迁移到代理名单：%s" % n)
        if is_blacklisted(n):
            msgs.append("警告：“%s”是通用运行时名称，已按原样保留在代理名单中，建议执行 proxyctl remove %s。"
                        % (n, n))
    return new_text, msgs


def _require_init(parsed):
    if not parsed.initialized:
        raise ProxyctlError("配置尚未初始化（找不到 proxyctl 管理区块），请先执行：sudo proxyctl init")


def _unmanaged_note(parsed, name):
    hits = ["pname(%s) -> %s" % (n, o) for n, o in parsed.unmanaged_pname_rules() if n == name]
    if hits:
        return ("提示：routing 中还有不受 proxyctl 管理的规则涉及“%s”（%s）。由于首条命中生效，"
                "排在前面的 proxyctl 规则优先。" % (name, "；".join(hits)))
    return None


def op_add(text, name):
    validate_name(name)
    if is_blacklisted(name):
        raise ProxyctlError("拒绝加入代理名单。" + blacklist_reason(name))
    parsed = Parsed(text)
    _require_init(parsed)
    msgs = []
    lists = current_lists(parsed, msgs)
    if name in SAFETY_NAMES:
        if SAFETY_NAMES[name] == "proxy":
            msgs.append("“%s”已在安全区块中走代理，无需添加。" % name)
            return render(parsed, lists), msgs
        raise ProxyctlError("“%s”在安全区块中是直连（must_direct），它是代理核心，走代理会形成回环，拒绝添加。" % name)
    if name in [n for n, o in lists["safety"] if o == "must_direct"] or name in parsed.names("direct"):
        raise ProxyctlError("冲突：“%s”已在直连保护名单中。如确需代理，请先执行 proxyctl unprotect %s。" % (name, name))
    if name in parsed.names("proxy"):
        msgs.append("“%s”已在代理名单中，无需重复添加。" % name)
        return render(parsed, lists), msgs
    lists["proxy"].append((name, "proxy"))
    msgs.append("已加入代理名单：%s" % name)
    for note in (long_name_warning(name), _unmanaged_note(parsed, name)):
        if note:
            msgs.append(note)
    return render(parsed, lists), msgs


def op_remove(text, name):
    validate_name(name)
    parsed = Parsed(text)
    _require_init(parsed)
    msgs = []
    lists = current_lists(parsed, msgs)
    if name in [n for n, _ in lists["safety"]]:
        raise ProxyctlError("“%s”属于安全区块，任何命令都不能删除安全区块中的规则。" % name)
    if name not in parsed.names("proxy"):
        raise ProxyctlError("“%s”不在代理名单中。" % name)
    lists["proxy"] = [e for e in lists["proxy"] if e[0] != name]
    msgs.append("已从代理名单移除：%s" % name)
    return render(parsed, lists), msgs


def op_protect(text, name):
    validate_name(name)
    parsed = Parsed(text)
    _require_init(parsed)
    msgs = []
    lists = current_lists(parsed, msgs)
    safety = dict(lists["safety"])
    if name in safety:
        if safety[name] == "must_direct":
            msgs.append("“%s”已在安全区块中直连保护，无需添加。" % name)
            return render(parsed, lists), msgs
        raise ProxyctlError("“%s”在安全区块中走代理（用于自检），不能改为直连。" % name)
    if name in parsed.names("proxy"):
        raise ProxyctlError("冲突：“%s”在代理名单中。如需改为直连保护，请先执行 proxyctl remove %s。" % (name, name))
    if name in parsed.names("direct"):
        msgs.append("“%s”已在直连保护名单中，无需重复添加。" % name)
        return render(parsed, lists), msgs
    lists["direct"].append((name, "must_direct"))
    msgs.append("已加入直连保护：%s" % name)
    for note in (long_name_warning(name), _unmanaged_note(parsed, name)):
        if note:
            msgs.append(note)
    return render(parsed, lists), msgs


def op_unprotect(text, name):
    validate_name(name)
