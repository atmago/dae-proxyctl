CONF_KEYS = ("socks", "config", "service", "iface", "test_url", "probe_url", "slow_seconds",
             "connect_slow", "test_retries", "chain_interval", "gui_recent")
_conf_cache = {}


def conf_path():
    return os.environ.get("PROXYCTL_CONF") or "/etc/proxyctl.conf"


def load_conf(path):
    """读取 key = value 格式的配置；文件必须属于 root（或当前用户）且不可被他人写入，否则忽略。"""
    if path in _conf_cache:
        return _conf_cache[path]
    values = {}
    try:
        with open(path, encoding="utf-8") as f:
            st = os.fstat(f.fileno())
            if st.st_uid in (0, os.geteuid()) and not st.st_mode & 0o022:
                for line in f:
                    line = line.split("#", 1)[0].strip()
                    key, sep, value = line.partition("=")
                    key = key.strip().lower()
                    if sep and key in CONF_KEYS and value.strip():
                        values[key] = value.strip()
            else:
                print("警告：%s 不属于 root，或可被其他用户写入，已忽略。" % path, file=sys.stderr)
    except OSError:
        pass
    _conf_cache[path] = values
    return values


def _env(name, default):
    """优先级：环境变量 > /etc/proxyctl.conf > 内置默认值。"""
    value = os.environ.get(name)
    if value:
        return value
    return load_conf(conf_path()).get(name[len("PROXYCTL_"):].lower(), default)


