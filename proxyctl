def can_write_config():
    target = config_path()
    d = os.path.dirname(os.path.abspath(target))
    sd = state_dir()
    sd_ok = os.access(sd, os.W_OK) if os.path.exists(sd) else os.access(os.path.dirname(sd.rstrip("/")) or "/", os.W_OK)
    return os.access(d, os.W_OK) and os.access(target, os.R_OK | os.W_OK) and sd_ok


def ensure_root(argv, need):
    """需要 root 且当前不能直接完成时：终端里用 sudo 重新执行自身，否则报错。"""
    if os.geteuid() == 0 or not need():
        return
    hint = "此操作需要 root 权限，请执行：sudo proxyctl %s" % " ".join(argv)
    if os.environ.get("PROXYCTL_NO_ESCALATE"):
        raise ProxyctlError(hint)
    if not (sys.stdin.isatty() and sys.stderr.isatty()):
        raise ProxyctlError(hint)
    envs = ["%s=%s" % (k, v) for k, v in sorted(os.environ.items()) if k.startswith("PROXYCTL_")]
    me = os.path.realpath(sys.argv[0])
    cmd = [sudo_bin(), "--"]
    if envs:
        cmd += ["env"] + envs
    cmd += [sys.executable, me] + list(argv)
    print("需要 root 权限，正在通过 sudo 重新执行……", file=sys.stderr)
    sys.stdout.flush()
    sys.stderr.flush()
    try:
        os.execvp(cmd[0], cmd)
    except OSError as e:
        raise ProxyctlError("无法执行 sudo：%s。%s" % (e, hint))


