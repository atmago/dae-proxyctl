# 规则视图（读取配置；非 root 时退回到缓存）
# ---------------------------------------------------------------------------


def read_config_text():
    with open(config_path(), "rb") as f:
        data = f.read()
    try:
        return data.decode("utf-8"), data
    except UnicodeDecodeError:
        raise ProxyctlError("配置文件不是 UTF-8 编码，无法安全编辑，未做任何修改。")


def rules_view_from_parsed(parsed):
    msgs = []
    lists = current_lists(parsed, msgs) if parsed.initialized else {b: [] for b in BLOCKS}
    return {
        "initialized": parsed.initialized,
        "safety": [list(e) for e in (lists["safety"] if parsed.initialized else [])],
        "direct": parsed.names("direct"),
        "proxy": parsed.names("proxy"),
        "unmanaged_pname": [list(e) for e in parsed.unmanaged_pname_rules()],
        "unmanaged": [c for _, c in parsed.unmanaged_rules()],
        "dns": dns_config_from_parsed(parsed),
    }


def write_cache(view):
    """把名单写入 0644 的缓存文件，供非 root 的 list / rules / GUI 读取。只含进程名规则。"""
    try:
        data = dict(view)
        data.pop("unmanaged", None)
        data["updated"] = datetime.datetime.now().isoformat(timespec="seconds")
        os.makedirs(state_dir(), mode=0o755, exist_ok=True)
        fd, tmp = tempfile.mkstemp(dir=state_dir(), prefix=".rules.", suffix=".json")
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(data, f, ensure_ascii=False, indent=1)
        os.chmod(tmp, 0o644)
        os.replace(tmp, cache_path())
    except OSError:
        pass


def load_rules_view():
    """返回 (view 或 None, 来源说明)。"""
    try:
        text, _ = read_config_text()
        view = rules_view_from_parsed(Parsed(text))
        view["source"] = "config"
        if os.geteuid() == 0:
            write_cache(view)
        return view, None
    except PermissionError:
        pass
    except (OSError, ProxyctlError) as e:
        return None, "无法读取配置：%s" % e
    try:
        with open(cache_path(), "r", encoding="utf-8") as f:
            view = json.load(f)
        view["source"] = "cache"
        return view, "（非 root：配置文件不可读，规则来自 %s 缓存，更新于 %s）" % (cache_path(), view.get("updated", "?"))
    except (OSError, ValueError):
        return None, "（非 root：配置文件不可读，也没有规则缓存。以 sudo 运行可看到规则。）"


def status_of(name, view):
    if view is None:
        return STATUS_UNKNOWN
    safety = {n: o for n, o in view.get("safety", [])}
    if name in view.get("proxy", []) or safety.get(name) == "proxy":
        return STATUS_PROXY
    if name in view.get("direct", []) or safety.get(name) == "must_direct":
        return STATUS_DIRECT
    for n, o in view.get("unmanaged_pname", []):
        if n == name:
            return "其他规则(%s)" % o
    return STATUS_DEFAULT


# ---------------------------------------------------------------------------
# DNS 走向：应用的域名解析请求经过哪里、谁能看到、会不会被污染
# ---------------------------------------------------------------------------

SECTION_OPEN_RE = re.compile(r"^\s*([A-Za-z_][A-Za-z0-9_-]*)\s*\{\s*$")
KV_RE = re.compile(r"^\s*([A-Za-z_][A-Za-z0-9_-]*)\s*:\s*(.+?)\s*$")
UPSTREAM_RE = re.compile(r"^([a-z0-9+]+)://(?:[^@/]*@)?(\[[^\]]+\]|[^:/?#]+)(?::(\d+))?")
DIAL_MODES = ("ip", "domain", "domain+", "domain++")
DIP_RULE_RE = re.compile(r"^dip\(\s*([^()]+?)\s*\)\s*->\s*([A-Za-z_][A-Za-z0-9_()-]*)$")
ENCRYPTED_SCHEMES = {"https": "DoH", "tls": "DoT", "quic": "DoQ", "h3": "DoH3", "http3": "DoH3"}
RESOLVED_STUBS = ("127.0.0.53", "127.0.0.54")
RESOLVED_COMM = "systemd-resolve"  # systemd-resolved 的进程名被内核截断为 15 个字符


def config_sections(parsed):
    """把配置按嵌套区块分组：{("dns", "routing", "request"): [代码行, ...]}。只用于展示，不用于写回。"""
    out = {}
    stack = []
    for line in parsed.lines:
        code = code_part(line, keep_strings=True).strip()
        if not code:
            continue
        m = SECTION_OPEN_RE.match(code)
        if m:
            stack.append(m.group(1))
            out.setdefault(tuple(stack), [])
            continue
        if code == "}":
            if stack:
                stack.pop()
            continue
        if stack:
            out.setdefault(tuple(stack), []).append(code)
    return out


def _kv(lines):
    kv = {}
    for code in lines:
        m = KV_RE.match(code)
        if m and m.group(1) not in kv:
            kv[m.group(1)] = m.group(2).strip("'\"")
    return kv


def parse_upstream(url):
    """dae 的 upstream 地址 → {scheme, host, port}。故意丢掉路径和用户信息（例如 NextDNS 的私有 ID），
    因为结果会写进所有人可读的规则缓存。"""
    m = UPSTREAM_RE.match(url.strip())
    if not m:
        return {"scheme": "?", "host": "?", "port": None}
    scheme = m.group(1)
    default = {"https": 443, "tls": 853, "quic": 853, "h3": 443, "http3": 443}.get(scheme, 53)
    return {"scheme": scheme, "host": m.group(2).strip("[]"), "port": int(m.group(3) or default)}


def dns_config_from_parsed(parsed):
    secs = config_sections(parsed)
    dial = (_kv(secs.get(("global",), [])).get("dial_mode") or "domain").lower()
    upstreams = {}
    for code in secs.get(("dns", "upstream"), []):
        m = KV_RE.match(code)
        if m:
            upstreams[m.group(1)] = parse_upstream(m.group(2).strip("'\""))
    request = secs.get(("dns", "routing", "request"), [])
    return {
        "dial_mode": dial,
        "has_dns": ("dns",) in secs,
        "upstreams": upstreams,
        "request_fallback": _kv(request).get("fallback"),
        "request_rules": len([c for c in request if not c.startswith("fallback")]),
        "routing_fallback": _kv(secs.get(("routing",), [])).get("fallback"),
        "protect": parsed.dns_protected,
        # 单独的 dip(...) -> 出口 规则：推演 DNS 上游查询的出口时会用到
        "dip_rules": [[m.group(1), m.group(2)] for m in
                      (DIP_RULE_RE.match(c) for c in secs.get(("routing",), [])) if m],
        # 可能影响 DNS 包走向、但 proxyctl 不去推演的规则（dport / l4proto / 组合规则等）
        "other_rules": [c for c in secs.get(("routing",), [])
                        if not c.startswith("fallback") and not RULE_RE.match(c) and not DIP_RULE_RE.match(c)],
    }


def _nameservers(path):
    out = []
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            for line in f:
                parts = line.split()
                if len(parts) >= 2 and parts[0] == "nameserver":
                    out.append(parts[1].split("%")[0])
    except OSError:
        return None
    return out


def resolver_info():
    """本机应用把 DNS 请求交给谁。"""
    ns = _nameservers(resolv_conf_path())
    info = {"nameservers": ns or [], "kind": "unknown", "upstreams": [], "dot": None}
    if ns is None:
        return info
    if any(n in RESOLVED_STUBS for n in ns):
        info["kind"] = "resolved"
        info["upstreams"] = [n for n in (_nameservers(resolved_conf_path()) or []) if n not in RESOLVED_STUBS]
        rc, out = run_cmd([resolvectl_bin(), "status"], timeout=5)
        if rc == 0:
            # 只看 Global 和默认路由网卡的协议行
            info["dot"] = bool(re.search(r"\+DNSOverTLS", out))
    elif ns and all(_is_loopback(n) for n in ns):
        info["kind"] = "local"  # dnsmasq 等本机 DNS 程序
    elif ns:
        info["kind"] = "direct"  # 应用进程自己把请求发给外部 DNS
    return info


def _is_loopback(addr):
    try:
        return ipaddress.ip_address(addr).is_loopback
    except ValueError:
        return False


def route_of(name, view):
    """按 routing 首条命中推算某个进程名的出口。返回 (出口, 依据)。"""
    comm = name[:COMM_MAX]
    for n, o in (view or {}).get("safety", []):
        if n[:COMM_MAX] == comm:
            return o, "安全区块 pname(%s)" % n
    for n in (view or {}).get("direct", []):
        if n[:COMM_MAX] == comm:
            return "must_direct", "直连保护 pname(%s)" % n
    for n in (view or {}).get("proxy", []):
        if n[:COMM_MAX] == comm:
            return "proxy", "代理名单 pname(%s)" % n
    for n, o in (view or {}).get("unmanaged_pname", []):
        if n[:COMM_MAX] == comm:
            return o, "routing 规则 pname(%s)" % n
    fb = ((view or {}).get("dns") or {}).get("routing_fallback")
    return (fb or "direct"), ("routing 的 fallback" if fb else "routing 的 fallback（未读到，按 direct 推断）")


def dip_route(ip, view):
    """按 routing 中单独的 dip 规则推算发往 ip 的出口；没有命中返回 None。"""
    try:
        addr = ipaddress.ip_address(ip)
    except ValueError:
        return None
    for cidrs, outbound in ((view or {}).get("dns") or {}).get("dip_rules", []):
        for c in cidrs.split(","):
            c = c.strip()
            try:
                if addr in ipaddress.ip_network(c, strict=False):
                    return outbound, "routing 规则 dip(%s)" % cidrs
            except ValueError:
                continue  # geoip:cn 等不推演
    return None


def upstream_route(sender, ips, view):
    """dae 向上游查询时的出口：进程名规则优先（它们排在最前），否则看 dip 规则，最后是 fallback。"""
    outbound, why = route_of(sender, view)
    if why.startswith("routing 的 fallback"):
        for ip in ips:
            hit = dip_route(ip, view)
            if hit:
                return hit
    return outbound, why


def outbound_text(o):
    if o == "must_direct":
        return "直连（must_direct）"
    if o in ("direct", "block"):
        return {"direct": "直连", "block": "丢弃（block）"}[o]
    return "代理（%s）" % o


def app_dns_sockets(name, conns):
    """这个程序自己正在进行的 DNS 连接（远端端口 53 / 853，不含发往本机 stub 的）。"""
    ports = set()
    for c in conns or []:
        if c["peer_port"] in ("53", "853") and not c["peer_ip"].is_loopback \
                and any(n[:COMM_MAX] == name[:COMM_MAX] for n, _ in c["procs"]):
            ports.add(c["peer_port"])
    return ports


def dns_route(app, view, resolver, conns=None):
    """推演一个程序的 DNS 走向。

    返回 {"steps": [(标题, 说明, 级别)], "facts": {...}}，级别为 ok / warn / info。
    依据 dae 的行为：发往 53 端口的请求被 dae 的 DNS 模块接管，除非命中 must_direct；
    dae 向上游查询时按“发出请求的进程名 + 上游地址”再匹配一次 routing。
    """
    dns = (view or {}).get("dns") or {}
    dial = dns.get("dial_mode") or "domain"
    steps = []
    own = app_dns_sockets(app, conns)
    kind = resolver.get("kind")
    if own:
        sender = app
        who = "“%s”自己直接向外发 DNS 请求（观察到发往 %s 端口的连接）。" % (
            app, " / ".join(sorted(own)))
        servers = []
        dot = "853" in own and "53" not in own
    elif kind == "resolved":
        sender = RESOLVED_COMM
        servers = resolver.get("upstreams") or []
        who = "“%s”把域名交给本机 systemd-resolved（127.0.0.53）代查。向外发请求的是 %s 进程，" \
              "不是程序本身，所以代理名单管不到 DNS。" % (app, RESOLVED_COMM)
        dot = bool(resolver.get("dot"))
    elif kind == "direct":
        sender = app
        servers = resolver.get("nameservers") or []
        who = "“%s”按 /etc/resolv.conf 自己向 %s 发 DNS 请求。" % (app, "、".join(servers))
        dot = False
    elif kind == "local":
        sender = None
        servers = resolver.get("nameservers") or []
        who = "“%s”把域名交给本机的 DNS 程序（%s），向外查询的是哪个进程无法确定。" % (app, "、".join(servers))
        dot = False
    else:
        sender = None
        servers = []
        who = "读不到 /etc/resolv.conf，无法确定“%s”把 DNS 请求交给了谁。" % app
        dot = False
    steps.append(("应用发起解析", who, "info"))

    facts = {"sender": sender, "visible_to": None, "encrypted": None, "poison_safe": dial != "ip"}
    if sender is None:
        steps.append(("向外查询", "无法推断（取决于本机 DNS 程序自身的设置）。", "warn"))
    else:
        fb = dns.get("request_fallback")
        ups = dns.get("upstreams") or {}
        dae_up = ups.get(fb) if (dns.get("has_dns") and fb and fb != "asis" and not dot) else None
        outbound, why = upstream_route(sender, [dae_up["host"]] if dae_up else servers, view)
        facts["outbound"] = outbound
        srv = "、".join(servers) if servers else "原目标服务器"
        if dot:
            enc_how = "DoT 加密（853 端口）"
            steps.append(("向外查询",
                          "%s 用 %s 发往 %s。dae 只接管 53 端口，这里不经过 dae 的 DNS 模块；"
                          "按 %s 走%s。" % (sender, enc_how, srv, why, outbound_text(outbound)), "ok"))
            facts["encrypted"] = True
            facts["visible_to"] = "DNS 服务器（%s）" % srv
        elif outbound == "must_direct":
            steps.append(("向外查询",
                          "%s 命中 %s，dae 不接管，以明文 UDP 直接发往 %s。" % (sender, why, srv), "warn"))
            facts["encrypted"] = False
            facts["visible_to"] = "本地网络、运营商和 DNS 服务器（%s）" % srv
        else:
            if dae_up:
                u = dae_up
                target = "%s（%s://%s:%s）" % (fb, u["scheme"], u["host"], u["port"])
                enc = ENCRYPTED_SCHEMES.get(u["scheme"])
                extra = "（另有 %d 条 dns 请求规则可能把部分域名分给别的上游）" % dns["request_rules"] \
                    if dns.get("request_rules") else ""
                sent_to = " dae 配置的上游 %s%s" % (target, extra)
            else:
                enc = None
                sent_to = "原来的 %s（dae 未配置 DNS 上游，按原目标转发）" % srv
            facts["encrypted"] = bool(enc)
            level = "ok" if enc or outbound not in ("direct", "must_direct") else "warn"
            steps.append(("dae 接管",
                          "发往 53 端口的请求被 dae 的 DNS 模块接管，dae 顺便记下“域名 → IP”用于分流。", "info"))
            if dns.get("protect") and dae_up and fb == PROTECT_DNS_UPSTREAM:
                steps.append(("向外查询",
                              "DNS 防泄漏已开启：国外域名由 dae 经%s发给 %s，查询在代理隧道里，运营商看不到"
                              "（依据 %s）。国内和局域网域名照旧直连查询 %s。"
                              % (outbound_text(outbound), PROTECT_DNS_IP, why, srv), level))
            else:
                steps.append(("向外查询",
                              "dae %s发给%s。这个请求来自 %s，命中 %s，走%s。"
                              % ("以 %s 加密" % enc if enc else "以明文 UDP ", sent_to, sender, why,
                                 outbound_text(outbound)), level))
            if enc:
                facts["visible_to"] = "DNS 上游服务器" + ("（经代理节点转发）" if outbound not in ("direct", "must_direct") else "")
            elif outbound in ("direct", "must_direct"):
                facts["visible_to"] = "本地网络、运营商和 DNS 服务器"
            else:
                facts["visible_to"] = "代理节点和 DNS 服务器（本地网络看不到）"
            if dns.get("protect") and dae_up:
                facts["visible_to"] += "；国内和局域网域名仍由本地网络可见"
        if dns.get("other_rules"):
            steps.append(("注意",
                          "routing 中还有 %d 条非进程名规则（如 dip / dport），它们排在 proxyctl 规则之后，"
                          "如果匹配到 DNS 包可能改变上面的结论：%s"
                          % (len(dns["other_rules"]), "；".join(dns["other_rules"][:3])), "info"))

    app_out, app_why = route_of(app, view)
    app_why = app_why.split(" pname(")[0]  # 同一组程序共用说明，不带各自的名字
    if app_why[:1].isascii():
        app_why = " " + app_why + (" " if app_why[-1:].isascii() else "")
    if app_out in ("direct", "must_direct", "block"):
        steps.append(("建立连接", "连接按%s走%s，使用上面解析到的 IP。" % (app_why, outbound_text(app_out)), "info"))
        facts["poison_safe"] = False
    elif dial == "ip":
        steps.append(("建立连接",
                      "连接按%s走代理。dial_mode 为 ip：dae 把本地解析得到的 IP 交给代理节点，"
                      "本地 DNS 被污染时连接会发往错误的地址。" % app_why, "warn"))
    else:
        steps.append(("建立连接",
                      "连接按%s走代理。dial_mode 为 %s：dae 从握手中嗅探出域名交给代理节点，由节点重新解析，"
                      "本地 DNS 被污染也不影响。（嗅探不到域名的连接仍使用本地解析的 IP。）" % (app_why, dial), "ok"))
    return {"steps": steps, "facts": facts}


def raw_connections():
    try:
        return ss_connections()
    except ProxyctlError:
        return []


def dns_badge(route, app_outbound):
    """一行进程旁边的 DNS 简要标签：(文字, 级别, 详细说明)。级别 ok / warn / plain。

    代理程序的 DNS 如果让本地网络看得到（明文直连），标为 warn；直连程序的 DNS 本来就直连，不算问题。
    """
    f = route["facts"]
    detail = "\n".join("%d. %s：%s" % (i, t, d) for i, (t, d, _) in enumerate(route["steps"], 1))
    detail += "\n\n" + "\n".join(dns_summary(route)[:2])
    if f.get("sender") is None or f.get("encrypted") is None:
        return "DNS 未知", "plain", detail
    via = "直连" if f.get("outbound") in ("direct", "must_direct") else "代理"
    # 走代理时查询在隧道里，运营商看不到，明文与否不再重要
    text = "DNS 代理" if via == "代理" else "DNS 直连·%s" % ("加密" if f["encrypted"] else "明文")
    proxied = app_outbound not in ("direct", "must_direct", "block")
    if not proxied:
        level = "plain"
    elif via == "直连" and not f["encrypted"]:
        level = "warn"
    else:
        level = "ok"
    return text, level, detail


def dns_groups(names, view, resolver, conns):
    """把 DNS 走向相同的程序归为一组，返回 [(程序名列表, route)]。"""
    groups = []
    for n in names:
        r = dns_route(n, view, resolver, conns)
        key = json.dumps([[t, d.replace("“%s”" % n, "“{app}”"), lv] for t, d, lv in r["steps"]] + [r["facts"]],
                         ensure_ascii=False, sort_keys=True)
        for g in groups:
            if g[0] == key:
                g[1].append(n)
                break
        else:
            groups.append((key, [n], r))
    out = []
    for _, members, r in groups:
        if len(members) > 1:
            first = "“%s”" % members[0]
            r = {"steps": [(t, d.replace(first, "这些程序"), lv) for t, d, lv in r["steps"]], "facts": r["facts"]}
        out.append((members, r))
    return out


def dns_summary(route):
    f = route["facts"]
    lines = []
    if f.get("visible_to"):
        lines.append("谁能看到访问的域名：%s。" % f["visible_to"])
    if f.get("poison_safe"):
        lines.append("本地 DNS 污染：不影响走代理的连接（节点重新解析域名）。")
    else:
        lines.append("本地 DNS 污染：会影响（连接使用本地解析的 IP）。")
    lines.append("如果程序自带 DoH（如浏览器的“安全 DNS”），它的 DNS 在自己的 HTTPS 连接里，跟随程序走代理，不经过上面的路径。")
    return lines


# ---------------------------------------------------------------------------
# 事务：锁 → 备份 → 临时文件 → validate → rename → reload → 确认 active
# ---------------------------------------------------------------------------


class FileLock(object):
    def __init__(self, path, timeout):
        self.path = path
        self.timeout = timeout
        self.fd = None

    def __enter__(self):
        os.makedirs(os.path.dirname(self.path), mode=0o755, exist_ok=True)
        self.fd = os.open(self.path, os.O_RDWR | os.O_CREAT, 0o600)
        deadline = time.monotonic() + self.timeout
        while True:
            try:
                fcntl.flock(self.fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                return self
            except BlockingIOError:
                if time.monotonic() >= deadline:
                    os.close(self.fd)
                    self.fd = None
                    raise ProxyctlError("另一个 proxyctl 正在修改配置（锁文件 %s），等待 %.0f 秒后仍未释放，已放弃。"
                                        % (self.path, self.timeout))
                time.sleep(0.1)

    def __exit__(self, *exc):
        if self.fd is not None:
            fcntl.flock(self.fd, fcntl.LOCK_UN)
            os.close(self.fd)
            self.fd = None


BACKUP_RE = re.compile(r"^config-\d{8}-\d{6}-\d{6}-[a-z-]+\.dae$")
BACKUP_KEEP = 30


def make_backup(data, opname):
    d = backup_dir()
    os.makedirs(d, mode=0o700, exist_ok=True)
    stamp = datetime.datetime.now().strftime("%Y%m%d-%H%M%S-%f")
    name = "config-%s-%s.dae" % (stamp, re.sub(r"[^a-z-]", "", opname) or "op")
    path = os.path.join(d, name)
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, "wb") as f:
        f.write(data)
        f.flush()
        os.fsync(f.fileno())
    prune_backups()
    return path


def list_backups():
    try:
        names = [n for n in os.listdir(backup_dir()) if BACKUP_RE.match(n)]
    except FileNotFoundError:
        return []
    return sorted(names)


def prune_backups():
    names = list_backups()
    for n in names[:-BACKUP_KEEP] if len(names) > BACKUP_KEEP else []:
        try:
            os.unlink(os.path.join(backup_dir(), n))
        except OSError:
            pass


def _fsync_dir(d):
    try:
        fd = os.open(d, os.O_RDONLY)
        try:
            os.fsync(fd)
        finally:
            os.close(fd)
    except OSError:
        pass


def write_temp(data):
    """在目标同目录生成临时文件（root:root 0600；非 root 测试时保持当前用户）。
    dae 要求配置文件以 .dae 结尾，所以临时文件也用 .dae 后缀。"""
    target = config_path()
    d = os.path.dirname(os.path.abspath(target))
    fd, tmp = tempfile.mkstemp(dir=d, prefix=".proxyctl-tmp-", suffix=".dae")
    try:
        os.fchmod(fd, 0o600)
        if os.geteuid() == 0:
            os.fchown(fd, 0, 0)
        with os.fdopen(fd, "wb") as f:
            f.write(data)
            f.flush()
            os.fsync(f.fileno())
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise
    return tmp


def install_file(tmp):
    target = config_path()
    os.replace(tmp, target)
    _fsync_dir(os.path.dirname(os.path.abspath(target)))


def transact(opname, compute):
    """执行一次写配置事务。compute(旧文本) -> (新文本, 消息)。返回退出码。"""
    target = config_path()
    with FileLock(lock_path(), lock_timeout()):
        try:
            old_text, old_bytes = read_config_text()
        except PermissionError:
            raise ProxyctlError("没有权限读取 %s，请用 sudo 运行。" % target)
        except FileNotFoundError:
            raise ProxyctlError("找不到配置文件 %s。" % target)
        new_text, msgs = compute(old_text)
        for m in msgs:
            print(m)
        if new_text == old_text:
            print("配置无变化，未写入，也未重新加载 dae。")
            write_cache(rules_view_from_parsed(Parsed(new_text)))
            return 0
        new_bytes = new_text.encode("utf-8")
        backup = make_backup(old_bytes, opname)
        print("已备份原配置：%s" % backup)

        tmp = write_temp(new_bytes)
        rc, out = dae_validate(tmp)
        if rc != 0:
            try:
                os.unlink(tmp)
            except OSError:
                pass
            raise ProxyctlError("新配置未通过 dae validate，已放弃修改，原配置保持不变。\ndae 输出：\n%s"
                                % out.strip())

        was_active = service_active()
        reloaded = False
        try:
            install_file(tmp)
            tmp = None
            if was_active:
                reloaded = True
                rc, out = service_reload()
                if rc != 0:
                    raise ProxyctlError("systemctl reload %s 失败：%s" % (service_name(), out.strip()))
                ok, state = wait_still_active(reload_settle())
                if not ok:
                    raise ProxyctlError("reload 后 %s 服务状态为“%s”，不是 active。" % (service_name(), state))
        except BaseException as e:
            if tmp:
                try:
                    os.unlink(tmp)
                except OSError:
                    pass
            detail = rollback(old_bytes, reloaded)
            if isinstance(e, ProxyctlError):
                raise ProxyctlError("%s\n%s\n备份文件：%s" % (e, detail, backup))
            raise ProxyctlError("写入配置时发生意外错误：%r\n%s\n备份文件：%s" % (e, detail, backup))

        write_cache(rules_view_from_parsed(Parsed(new_text)))
        if was_active:
            print("配置已通过校验并生效（dae 已 reload，仍为 active）。")
            print("注意：dae 重新加载会断开所有正在走代理的连接，名单中正在运行的程序会自动重连。"
                  "Signal 重连较慢，可能显示离线几十秒到 1～2 分钟；想立刻恢复，可从托盘退出 Signal 再重新打开。")
        else:
            print("配置已通过校验并写入。注意：dae 当前未运行（状态：%s），配置将在 dae 下次启动时生效；"
                  "在此之前名单中的程序会直接连接外网。" % service_state())
        return 0


def rollback(old_bytes, reloaded):
    """恢复旧配置；如已 reload 则再次 reload。返回说明文字。"""
    lines = ["正在自动回滚……"]
    try:
        tmp = write_temp(old_bytes)
        install_file(tmp)
        lines.append("已恢复原配置文件。")
    except Exception as e:  # noqa
        lines.append("严重：恢复原配置文件失败（%r）！请立即执行 proxyctl restore 手工恢复。" % (e,))
        return "\n".join(lines)
    if reloaded:
        rc, out = service_reload()
        ok, state = wait_still_active(reload_settle())
        if rc == 0 and ok:
            lines.append("已再次 reload，dae 已恢复为原配置并处于 active。")
        else:
            lines.append("再次 reload 后 dae 状态为“%s”%s。请检查：journalctl -u %s -e ；必要时 sudo systemctl restart %s。"
                         "在 dae 恢复之前，名单中的程序会直接连接外网（故障即放行）。"
                         % (state, ("，reload 输出：" + out.strip()) if rc != 0 else "",
                            service_name(), service_name()))
    return "\n".join(lines)


